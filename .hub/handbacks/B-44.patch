new file mode 100755
index 0000000..2ad939a
--- /dev/null
+++ b/scripts/validation-selftest.sh
@@ -0,0 +1,168 @@
+#!/usr/bin/env bash
+# Prove that each validation gate can still fail.
+#
+# A gate that has never been shown to fail is indistinguishable from one
+# that cannot. This repo shipped three such gates (docs/tech-debt.md,
+# 2026-08-16, records a fourth): SHACL shapes bound to a namespace no
+# subject used, a competency-question file no engine could parse, and a
+# ROBOT profile that replaced the default profile with two INFO rules so
+# `--fail-on ERROR` had nothing to fail on. Each passed for months.
+#
+# This script points each gate at a fixture under tests/fixtures/ that is
+# broken on purpose, and asserts (a) the gate exits non-zero and (b) the
+# failure is the one the fixture was written to provoke -- not an
+# incidental one. It runs inside `make test`, so a change that makes a
+# gate vacuous again fails CI instead of waiting for a reader to notice.
+#
+# Four checks. Each states what would retire it.
+#
+#   1. SHACL. scripts/shacl-validate.sh over tests/fixtures/shacl/
+#      invalid-survey-data.ttl must fail, must report every message that
+#      fixture documents, and must NOT report the control node whose
+#      violation is snorkel-specific but whose method is aerial. That last
+#      assertion is what proves the conditional shapes are conditional and
+#      not merely non-contradictory. Retires with the shapes file.
+#   2. Competency queries. scripts/run-competency-questions.sh over
+#      tests/fixtures/sparql/ must fail (the fixture uses an undeclared
+#      prefix, which is a parse error). Retires with the runner.
+#   3. ROBOT report. `robot report --profile robot-profile.yaml --fail-on
+#      ERROR` over tests/fixtures/robot/duplicate-label.ttl must exit 1 with
+#      duplicate_label as its only ERROR rule -- a rule the pre-2026-09-10
+#      profile did not run at all. Retires if ROBOT gains a native way to
+#      amend the default profile.
+#   4. Profile provenance. robot-profile.yaml must be ROBOT's own default
+#      profile (report_profile.txt inside tools/robot.jar) with exactly two
+#      rules downgraded: missing_label and missing_definition, both to INFO.
+#      Any other difference -- a rule dropped, a level changed, a ROBOT
+#      upgrade that changed the default -- fails here with the diff, so the
+#      profile cannot quietly become a replacement again. Retires with
+#      check 3; the same ROBOT feature would make both moot.
+
+set -euo pipefail
+
+ROBOT_JAR="${ROBOT_JAR:-tools/robot.jar}"
+ROBOT_CATALOG="${ROBOT_CATALOG:-release/tmp/robot-catalog.xml}"
+PROFILE_FILE="${PROFILE_FILE:-robot-profile.yaml}"
+PYTHON="${PYTHON:-python3}"
+FIXTURES="${FIXTURES:-tests/fixtures}"
+OUT_DIR="release/tmp/selftest"
+
+if [ ! -f "$ROBOT_JAR" ]; then
+  echo "❌ ROBOT JAR not found at $ROBOT_JAR (run 'make install-robot')." >&2
+  exit 1
+fi
+
+mkdir -p "$OUT_DIR"
+failures=0
+
+fail() {
+  echo "❌ $1"
+  failures=$((failures + 1))
+}
+
+echo "🧪 Validation self-test: every gate must fail on its broken fixture"
+
+# ---------------------------------------------------------------- 1. SHACL
+echo ""
+echo "── SHACL gate vs $FIXTURES/shacl/invalid-survey-data.ttl"
+shacl_report="$OUT_DIR/shacl-invalid-report.txt"
+if REPORT_FILE="$shacl_report" ./scripts/shacl-validate.sh "$FIXTURES/shacl/invalid-survey-data.ttl" > "$OUT_DIR/shacl-invalid.log" 2>&1; then
+  fail "SHACL gate PASSED the invalid fixture (see $OUT_DIR/shacl-invalid.log). The shapes are vacuous."
+else
+  echo "✅ SHACL gate rejected the invalid fixture"
+  # Every message the fixture documents must be present, and the aerial
+  # control node must be absent.
+  expected_messages=(
+    "Measurement must be about a stock"
+    "Measurement must be observed during a survey event"
+    "Count value must be a non-negative integer"
+    "Count unit must be a valid IRI"
+    "violates a snorkel-specific constraint"
+    "Survey must specify an enumeration method"
+    "Visibility must be one of: Excellent, Good, Fair, Poor"
+  )
+  for msg in "${expected_messages[@]}"; do
+    if grep -qF -- "$msg" "$shacl_report"; then
+      echo "   ✅ reported: $msg"
+    else
+      fail "SHACL report is missing the expected violation: $msg (see $shacl_report)"
+    fi
+  done
+  if grep -qF -- "ControlAerial" "$shacl_report"; then
+    fail "SHACL report names the ControlAerial node: the snorkel-specific constraint fired on an aerial survey, so the conditional shape is not conditional (see $shacl_report)"
+  else
+    echo "   ✅ not reported: ControlAerial (snorkel-specific constraint stayed snorkel-specific)"
+  fi
+fi
+
+# --------------------------------------------------- 2. Competency queries
+echo ""
+echo "── Competency-question runner vs $FIXTURES/sparql/"
+if OUT_DIR="$OUT_DIR/competency" ./scripts/run-competency-questions.sh "$FIXTURES/sparql" > "$OUT_DIR/competency-invalid.log" 2>&1; then
+  fail "Competency runner PASSED a query with an undeclared prefix (see $OUT_DIR/competency-invalid.log). Parse errors are being swallowed."
+else
+  if grep -q "undeclared-prefix: query failed" "$OUT_DIR/competency-invalid.log"; then
+    echo "✅ Competency runner rejected the unparseable query"
+  else
+    fail "Competency runner failed, but not on the fixture query (see $OUT_DIR/competency-invalid.log)"
+  fi
+fi
+
+# ------------------------------------------------------ 3. ROBOT report
+echo ""
+echo "── ROBOT report gate vs $FIXTURES/robot/duplicate-label.ttl"
+robot_tsv="$OUT_DIR/robot-duplicate-label.tsv"
+rm -f "$robot_tsv"
+set +e
+java -jar "$ROBOT_JAR" report \
+  --input "$FIXTURES/robot/duplicate-label.ttl" \
+  --profile "$PROFILE_FILE" \
+  --fail-on ERROR \
+  --format TSV \
+  --output "$robot_tsv" > "$OUT_DIR/robot-duplicate-label.log" 2>&1
+robot_status=$?
+set -e
+if [ "$robot_status" -eq 0 ]; then
+  fail "ROBOT report PASSED the duplicate-label fixture with $PROFILE_FILE. The profile is not running duplicate_label at ERROR."
+elif [ "$robot_status" -ne 1 ]; then
+  fail "ROBOT report exited $robot_status on the fixture, which is a tool failure rather than a report failure (see $OUT_DIR/robot-duplicate-label.log)"
+else
+  error_rules="$(awk -F'\t' 'NR > 1 && $1 == "ERROR" { print $2 }' "$robot_tsv" | sort -u | tr '\n' ' ')"
+  if [ "$error_rules" = "duplicate_label " ]; then
+    echo "✅ ROBOT report failed the fixture, and only on duplicate_label (a rule the two-line profile never ran)"
+  else
+    fail "ROBOT report failed the fixture, but the ERROR rules were '${error_rules:-none}' rather than exactly duplicate_label (see $robot_tsv)"
+  fi
+fi
+
+# ------------------------------------------------- 4. Profile provenance
+echo ""
+echo "── $PROFILE_FILE is ROBOT's default profile with two documented downgrades"
+default_profile="$OUT_DIR/robot-default-profile.txt"
+"$PYTHON" - "$ROBOT_JAR" "$default_profile" <<'PY'
+import sys, zipfile
+jar, out = sys.argv[1], sys.argv[2]
+text = zipfile.ZipFile(jar).read("report_profile.txt").decode()
+with open(out, "w") as fh:
+    fh.write(text if text.endswith("\n") else text + "\n")
+PY
+# Line-number-independent diff: one line per removed (-) or added (+) rule.
+actual_diff="$(diff --unchanged-line-format= --old-line-format='-%L' --new-line-format='+%L' "$default_profile" "$PROFILE_FILE" | LC_ALL=C sort || true)"
+expected_diff="$(printf '%s\n' \
+  $'+INFO\tmissing_definition' \
+  $'+INFO\tmissing_label' \
+  $'-ERROR\tmissing_label' \
+  $'-WARN\tmissing_definition' | LC_ALL=C sort)"
+if [ "$actual_diff" = "$expected_diff" ]; then
+  echo "✅ $PROFILE_FILE = default profile ($(wc -l < "$default_profile" | tr -d ' ') rules) with missing_label and missing_definition at INFO; nothing else differs"
+else
+  fail "$PROFILE_FILE differs from ROBOT's default profile in more than the two documented downgrades. Re-derive it from the default (see docs/ROBOT_SETUP.md). Diff (- default, + ours):"
+  printf '%s\n' "$actual_diff" | sed 's/^/     /'
+fi
+
+echo ""
+if [ "$failures" -gt 0 ]; then
+  echo "❌ Validation self-test found $failures problem(s): at least one gate cannot fail, or fails for the wrong reason."
+  exit 1
+fi
+echo "✅ Validation self-test passed: every gate fails on its broken fixture, for the documented reason."
