index 0000000..a9dba70
--- /dev/null
+++ b/scripts/shacl-validate.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+# Run the SHACL shapes over instance data and fail on any violation.
+#
+# Usage: scripts/shacl-validate.sh [DATA_FILE]
+#   SHAPES_FILE   default ontology/shapes/dfo-salmon-shapes.ttl
+#   ONTOLOGY_FILE default ontology/dfo-salmon.ttl (added to the data graph so
+#                 that sh:targetClass sees rdfs:subClassOf declared by the
+#                 ontology; owl:imports are NOT followed, so no network)
+#   DATA_FILE     default ontology/examples/sample-survey-data.ttl
+#   REPORT_FILE   default release/tmp/shacl-report.txt
+#
+# Engine: pyshacl, pinned in scripts/requirements.txt to the newest release
+# that resolves against the rdflib pin CI installs (rdflib decides the bytes
+# of docs/gcdfo.jsonld, so it cannot float). ROBOT bundles no SHACL engine
+# (its jar carries jena-arq, not jena-shacl -- checked 2026-09-10 against
+# ROBOT 1.9.8), which is why this gate is Python where every other gate in
+# this repo is Java. See docs/adr/010.
+#
+# No --advanced flag on purpose: the shapes are SHACL core only. A
+# SHACL-AF feature (a SPARQL-based target, a rule) is ignored silently by an
+# engine that does not implement it, so a shape relying on one can report a
+# vacuous pass; the shapes file explains the core-only idiom it uses instead.
+# `make validation-selftest` proves this gate rejects
+# tests/fixtures/shacl/invalid-survey-data.ttl.
+
+set -euo pipefail
+
+SHAPES_FILE="${SHAPES_FILE:-ontology/shapes/dfo-salmon-shapes.ttl}"
+ONTOLOGY_FILE="${ONTOLOGY_FILE:-ontology/dfo-salmon.ttl}"
+DATA_FILE="${1:-${DATA_FILE:-ontology/examples/sample-survey-data.ttl}}"
+REPORT_FILE="${REPORT_FILE:-release/tmp/shacl-report.txt}"
+PYTHON="${PYTHON:-python3}"
+
+for f in "$SHAPES_FILE" "$ONTOLOGY_FILE" "$DATA_FILE"; do
+  if [ ! -f "$f" ]; then
+    echo "❌ File not found: $f" >&2
+    exit 1
+  fi
+done
+
+if ! "$PYTHON" -c 'import pyshacl' >/dev/null 2>&1; then
+  echo "❌ pyshacl is not importable by $PYTHON. Install the pinned deps:" >&2
+  echo "   $PYTHON -m pip install -r scripts/requirements.txt" >&2
+  exit 1
+fi
+
+mkdir -p "$(dirname "$REPORT_FILE")"
+
+echo "🔎 SHACL: $SHAPES_FILE over $DATA_FILE (+ $ONTOLOGY_FILE)"
+
+# pyshacl exits 0 when the data conforms and 1 when it does not; anything
+# else is a tool failure. Capture the report either way so a failure is
+# readable from the file CI uploads, then re-raise the exit code.
+set +e
+"$PYTHON" -m pyshacl \
+  --shacl "$SHAPES_FILE" \
+  --ont-graph "$ONTOLOGY_FILE" \
+  --format human \
+  "$DATA_FILE" > "$REPORT_FILE" 2>&1
+STATUS=$?
+set -e
+
+case "$STATUS" in
+  0)
+    echo "✅ SHACL: data conforms (report: $REPORT_FILE)"
+    ;;
+  1)
+    echo "❌ SHACL: data does not conform (report: $REPORT_FILE)"
+    sed 's/^/     /' "$REPORT_FILE"
+    exit 1
+    ;;
+  *)
+    echo "❌ SHACL: pyshacl failed with exit code $STATUS (see $REPORT_FILE)"
+    tail -n 20 "$REPORT_FILE" | sed 's/^/     /'
+    exit "$STATUS"
+    ;;
+esac
