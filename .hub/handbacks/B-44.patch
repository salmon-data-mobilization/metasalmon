+# Competency question 1: Find all stock status zones.
+#
+# One query per file: a .rq file is a single SPARQL request, and every prefix
+# it uses is declared here. Executed by scripts/run-competency-questions.sh
+# (`make competency-questions`) against ontology/dfo-salmon.ttl merged with
+# ontology/examples/sample-survey-data.ttl. Placeholder query carried over
+# from the original example file, unchanged in what it asks.
+
+PREFIX gcdfo: <https://w3id.org/gcdfo/salmon#>
+PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
+
+SELECT ?statusZone ?label ?definition WHERE {
+  ?statusZone a gcdfo:StockStatusZone ;
+              rdfs:label ?label ;
+              rdfs:comment ?definition .
+}
