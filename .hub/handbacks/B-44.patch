diff --git a/scripts/run-competency-questions.sh b/scripts/run-competency-questions.sh
new file mode 100755
index 0000000..8a90a7f
--- /dev/null
+++ b/scripts/run-competency-questions.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+# Execute every competency-question query, one file at a time, and fail on
+# any query that does not parse or does not run.
+#
+# Usage: scripts/run-competency-questions.sh [QUERY_DIR]
+#   QUERY_DIR     default ontology/sparql/competency (one SELECT per .rq file,
+#                 every prefix declared in the file)
+#   ONTOLOGY_FILE default ontology/dfo-salmon.ttl
+#   DATA_FILE     default ontology/examples/sample-survey-data.ttl
+#   ROBOT_JAR, ROBOT_CATALOG as in the other ROBOT scripts
+#
+# Why one file per query: a .rq file is a single SPARQL request. The shipped
+# ontology/sparql/example-competency-questions.rq held three SELECTs, so
+# ROBOT (and every other engine) rejected it with a parse error, and the
+# competency questions that docs/ADR.md presents as a quality gate had never
+# once been executed. This runner executes each query separately against
+# the ontology merged with the example data and reports a row count per
+# query. A parse error, an undeclared prefix or a ROBOT failure fails the
+# run. `make validation-selftest` proves that by pointing this script at
+# tests/fixtures/sparql/.
+#
+# Deliberately NOT a failure: a query that returns zero rows. Three of the
+# three shipped queries do today, because they name gcdfo:StockStatusZone,
+# gcdfo:SurveyEvent, gcdfo:ManagementUnit and gcdfo:hasMember, none of which
+# ontology/dfo-salmon.ttl declares. Deciding what each query should name is
+# a term decision, recorded in docs/tech-debt.md; this runner prints the
+# count so the emptiness is visible rather than hidden. Retires when: every
+# query in QUERY_DIR returns at least one row against the example data, at
+# which point `rows == 0` should become a failure here.
+
+set -euo pipefail
+
+QUERY_DIR="${1:-ontology/sparql/competency}"
+ONTOLOGY_FILE="${ONTOLOGY_FILE:-ontology/dfo-salmon.ttl}"
+DATA_FILE="${DATA_FILE:-ontology/examples/sample-survey-data.ttl}"
+ROBOT_JAR="${ROBOT_JAR:-tools/robot.jar}"
+ROBOT_CATALOG="${ROBOT_CATALOG:-release/tmp/robot-catalog.xml}"
+OUT_DIR="${OUT_DIR:-release/tmp/competency}"
+
+if ! command -v java >/dev/null 2>&1 || ! java -version >/dev/null 2>&1; then
+  echo "❌ Java is required to run ROBOT SPARQL queries." >&2
+  exit 1
+fi
+
+if [ ! -f "$ROBOT_JAR" ]; then
+  echo "❌ ROBOT JAR not found at $ROBOT_JAR (run 'make install-robot')." >&2
+  exit 1
+fi
+
+for f in "$ONTOLOGY_FILE" "$DATA_FILE"; do
+  if [ ! -f "$f" ]; then
+    echo "❌ File not found: $f" >&2
+    exit 1
+  fi
+done
+
+if [ ! -d "$QUERY_DIR" ]; then
+  echo "❌ Query directory not found: $QUERY_DIR" >&2
+  exit 1
+fi
+
+shopt -s nullglob
+queries=("$QUERY_DIR"/*.rq)
+shopt -u nullglob
+
+if [ "${#queries[@]}" -eq 0 ]; then
+  echo "❌ No .rq files in $QUERY_DIR. This runner exists to execute them; an" >&2
+  echo "   empty directory means either the queries moved or the path is wrong." >&2
+  exit 1
+fi
+
+ROBOT_CATALOG_ARGS=()
+if [ -n "$ROBOT_CATALOG" ] && [ -f "$ROBOT_CATALOG" ]; then
+  ROBOT_CATALOG_ARGS=(--catalog "$ROBOT_CATALOG")
+  echo "📚 Using ROBOT catalog for import resolution: $ROBOT_CATALOG"
+fi
+
+mkdir -p "$OUT_DIR"
+
+# Merge once, with the import closure collapsed so the merged file stands on
+# its own and each query below loads it without the catalog.
+MERGED="$OUT_DIR/ontology-with-examples.ttl"
+java -jar "$ROBOT_JAR" merge \
+  "${ROBOT_CATALOG_ARGS[@]}" \
+  --input "$ONTOLOGY_FILE" \
+  --input "$DATA_FILE" \
+  --collapse-import-closure true \
+  --output "$MERGED"
+
+echo "🔎 Running ${#queries[@]} competency question(s) from $QUERY_DIR"
+failures=0
+
+for query in "${queries[@]}"; do
+  name="$(basename "$query" .rq)"
+  out="$OUT_DIR/$name.tsv"
+  rm -f "$out"
+
+  # ROBOT exits non-zero on a parse error (which is what an undeclared
+  # prefix is) and on any load or execution failure. Do not swallow it.
+  if ! java -jar "$ROBOT_JAR" query \
+      --input "$MERGED" \
+      --query "$query" "$out" > "$OUT_DIR/$name.log" 2>&1; then
+    echo "❌ $name: query failed (see $OUT_DIR/$name.log)"
+    grep -v 'JAVA_TOOL_OPTIONS' "$OUT_DIR/$name.log" | head -n 5 | sed 's/^/     /'
+    failures=$((failures + 1))
+    continue
+  fi
+
+  # ROBOT writes no file, or an empty one, when a SELECT has no bindings;
+  # otherwise the first line is the header.
+  rows=0
+  if [ -s "$out" ]; then
+    rows=$(( $(wc -l < "$out") - 1 ))
+  fi
+
+  if [ "$rows" -gt 0 ]; then
+    echo "✅ $name: executed, $rows row(s) (see $out)"
+  else
+    echo "✅ $name: executed, 0 rows -- the query parses and runs but matches nothing in the example data; see the header of this script"
+  fi
+done
+
+if [ "$failures" -gt 0 ]; then
+  echo "❌ $failures competency question(s) failed to execute."
+  exit 1
+fi
+
+echo "✅ All competency questions executed."
