+@prefix owl:     <http://www.w3.org/2002/07/owl#> .
+@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
+@prefix dcterms: <http://purl.org/dc/terms/> .
+@prefix iao:     <http://purl.obolibrary.org/obo/IAO_> .
+@prefix :        <https://example.invalid/selftest#> .
+
+#################################################################
+# Deliberately BROKEN ontology fixture for the ROBOT report gate.
+#
+# Two classes share one rdfs:label. `duplicate_label` is one of the sixteen
+# ERROR-level checks in ROBOT's default report profile that robot-profile.yaml
+# silently dropped from 2025 until 2026-09-10, when it listed only two rules
+# (`--profile` REPLACES the default profile rather than amending it).
+# scripts/validation-selftest.sh runs `robot report --profile
+# robot-profile.yaml --fail-on ERROR` over this file and asserts that the
+# gate exits 1 and that the only ERROR rows are `duplicate_label` -- i.e.
+# the failure comes from a re-enabled check, not from the two rules the old
+# profile already ran.
+#
+# The ontology header carries a title, description and licence on purpose,
+# so that the three `missing_ontology_*` checks do not fire and the failure
+# is attributable to exactly one rule. Both classes carry a definition so
+# `missing_definition` (INFO) does not muddy the report either.
+#
+# Do not fix this ontology. Retires when: ROBOT gains a way to amend rather
+# than replace the default profile (robot-profile.yaml then holds only the
+# two overrides and this fixture proves nothing the default does not), or
+# the ROBOT gate is removed.
+#################################################################
+
+<https://example.invalid/selftest> a owl:Ontology ;
+  dcterms:title "Self-test fixture: duplicate label"@en ;
+  dcterms:description "A minimal ontology whose only defect is two classes sharing one label."@en ;
+  dcterms:license <https://creativecommons.org/licenses/by/4.0/> .
+
+:FirstThing a owl:Class ;
+  rdfs:label "Duplicated label"@en ;
+  iao:0000115 "The first of two classes that share a label."@en .
+
+:SecondThing a owl:Class ;
+  rdfs:label "Duplicated label"@en ;
+  iao:0000115 "The second of two classes that share a label."@en .
diff --git a/tests/fixtures/shacl/invalid-survey-data.ttl b/tests/fixtures/shacl/invalid-survey-data.ttl
new file mode 100644
index 0000000..c6047df
--- /dev/null
+++ b/tests/fixtures/shacl/invalid-survey-data.ttl
@@ -0,0 +1,85 @@
+@prefix gcdfo:     <https://w3id.org/gcdfo/salmon#> .
+@prefix smn:       <https://w3id.org/smn/> .
+@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
+@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
+@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
+@prefix :        <https://w3id.org/gcdfo/salmon#> .
+
+#################################################################
+# Deliberately INVALID survey data.
+#
+# This is not example data. It exists so that `make validation-selftest`
+# (scripts/validation-selftest.sh) can prove the SHACL gate still fails:
+# ontology/shapes/dfo-salmon-shapes.ttl must report every violation listed
+# below, and the self-test asserts on the messages, not only on the exit
+# code. A gate that cannot be shown to fail is the defect this file
+# guards against (queue item B-44 in the metasalmon hub).
+#
+# Do not "fix" this data. Retires when: the shapes file is deleted, or a
+# different mechanism proves the SHACL gate can fail.
+#################################################################
+
+# Violation 1 and 2: a measurement with no stock and no survey event.
+# Violation 3: a negative count.
+# (MeasurementShape: "Measurement must be about a stock",
+#  "Measurement must be observed during a survey event",
+#  "Count value must be a non-negative integer")
+:BrokenCount a gcdfo:EscapementMeasurement ;
+    rdfs:label "Broken count"@en ;
+    gcdfo:countValue -5 ;
+    gcdfo:countUnitIRI <http://qudt.org/vocab/unit/Each> .
+
+# Violation 4: a count unit that is a plain string, not an IRI.
+# (MeasurementShape: "Count unit must be a valid IRI")
+:BrokenUnit a gcdfo:EscapementMeasurement ;
+    rdfs:label "Broken unit"@en ;
+    gcdfo:aboutStock :SomeStock ;
+    gcdfo:observedDuring :BrokenSnorkel ;
+    gcdfo:countValue 10 ;
+    gcdfo:countUnitIRI "Each" .
+
+# Violation 5: a snorkel survey whose observer efficiency is above 1.0.
+# This one fires ONLY if the conditional (method-specific) targeting in
+# SnorkelSurveyShape is honoured by the engine. An engine that ignored the
+# conditional shapes would pass this node, so its presence here is what
+# keeps a silently-vacuous snorkel shape from going unnoticed.
+# (SnorkelSurveyShape: "Snorkel survey ... violates a snorkel-specific
+#  constraint")
+:BrokenSnorkel a gcdfo:EscapementSurveyEvent ;
+    rdfs:label "Broken snorkel survey"@en ;
+    gcdfo:usesEnumerationMethod :VisualSnorkelCount ;
+    gcdfo:usesEstimateMethod :PeakCountAnalysis ;
+    gcdfo:measuredVisits 3 ;
+    gcdfo:measuredReachCoverage 0.5 ;
+    gcdfo:measuredVisibility "Good" ;
+    gcdfo:measuredObserverEfficiency 1.5 ;
+    gcdfo:percentRiverSwam 50.0 ;
+    dwc:eventDate "2022-08-15"^^xsd:date .
+
+# Violation 6: a survey with no enumeration method and an unknown visibility.
+# (SurveyEventShape: "Survey must specify an enumeration method",
+#  "Visibility must be one of: Excellent, Good, Fair, Poor")
+:BrokenSurvey a gcdfo:EscapementSurveyEvent ;
+    rdfs:label "Broken survey"@en ;
+    gcdfo:usesEstimateMethod :PeakCountAnalysis ;
+    gcdfo:measuredVisits 2 ;
+    gcdfo:measuredVisibility "Great" ;
+    dwc:eventDate "2022-08-16"^^xsd:date .
+
+# Control: an aerial survey with an out-of-range observer efficiency must
+# NOT be reported by SnorkelSurveyShape (the constraint is snorkel-specific),
+# and there is no aerial-specific range rule. The self-test asserts this
+# node is absent from the report so the implication is known to be
+# conditional in both directions, not merely non-contradictory.
+:ControlAerial a gcdfo:EscapementSurveyEvent ;
+    rdfs:label "Control aerial survey"@en ;
+    gcdfo:usesEnumerationMethod :AerialSurveyCount ;
+    gcdfo:usesEstimateMethod :PeakCountAnalysis ;
+    gcdfo:measuredVisits 3 ;
+    gcdfo:measuredReachCoverage 0.9 ;
+    gcdfo:measuredVisibility "Excellent" ;
+    gcdfo:measuredObserverEfficiency 1.5 ;
+    dwc:eventDate "2022-08-25"^^xsd:date .
+
+:SomeStock a smn:Stock ;
+    rdfs:label "Some stock"@en .
