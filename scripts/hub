#!/usr/bin/env bash
#
# hub - the queue client for the salmon ecosystem hub.
#
# Planning state lives in one YAML file per work item under
# queue/items/. A claim is a plain `git push` of a commit to a ref
# under the claim prefix in a separate small locks repository. There is no
# GitHub Project here and no GitHub API call anywhere in this script. If you
# find yourself adding one, the design changed, and this file is the wrong
# place to record that.
#
# Design authority: knowledge/plans/2026-09-04-salmon-science-foundry-concrete-plan.md
# section 9. HUB.md at the repository root carries the policy and the writes
# register; this script implements the protocol and decides nothing.
#
# Retires when: claims stop living on git refs. At that point this script is
# deleted rather than widened, because every line of it is an argument about
# refs and none of it survives that change.
#
# EXIT CODES, and this is the single most important detail in the script:
#
#   0  the call did what it says it did
#   4  lost the race: the push was rejected because the ref already exists or
#      moved since it was read, or another agent demonstrably holds the item
#   3  the call failed for any other reason: no network, no credential, the
#      locks repository is missing, a bad ref, an ineligible item, or a
#      precondition this script could not verify
#
# Folding an expired credential into "someone else got there first" makes an
# agent spin silently through the whole queue reporting nothing wrong. So the
# classifier reads git's stderr, returns 4 only on the specific rejection
# strings that mean the ref moved, and DEFAULTS TO 3 WHEN UNSURE.
#
# THE COMPARE-AND-SWAP ARGUMENT, stated once so no later edit weakens it:
# git's own ref update is the atomic primitive, and it is used two ways.
#   * A first claim pushes an ORPHAN commit (no parent). An orphan can never
#     fast-forward an existing ref, so the push succeeds if and only if the ref
#     does not exist, which is to say if and only if nobody holds the item.
#   * Every later action (beat, release, handoff, reclaim) pushes a CHILD of
#     the tip that was just read. A child fast-forwards only that exact tip, so
#     the push succeeds if and only if nobody appended since the read.
# Race window zero, on both paths. This is why the script never passes --force
# or --force-with-lease: a forced push would replace the primitive with a
# last-writer-wins overwrite, silently, and nothing downstream would notice.
# The script also never deletes a ref, so the lock history stays append-only
# and auditable.

# -u catches an unset variable, which in a script that builds ref names out of
# configuration is the failure most likely to push to the wrong place.
# Deliberately NOT -e: classifying the exit status of git is this script's
# whole job, and -e would abort before the classification ran.
set -u
set -o pipefail

# C collation for every sort and pattern match in here. Item ordering is read
# by agents and compared between runs, so it must not depend on a locale.
LC_ALL=C
export LC_ALL

# A missing credential must fail rather than block an unattended agent on a
# prompt that nobody will ever answer.
export GIT_TERMINAL_PROMPT=0
: "${GIT_SSH_COMMAND:=ssh -o BatchMode=yes}"
export GIT_SSH_COMMAND

# An inherited git environment would silently redirect every plumbing call in
# here at whatever repository the caller was standing in.
# Strip every environment variable that can redirect a git operation. GIT_DIR,
# GIT_WORK_TREE and GIT_INDEX_FILE move where we read and write. The GIT_CONFIG_*
# family is the one that matters for the carve-out: GIT_CONFIG_COUNT plus
# GIT_CONFIG_KEY_n / GIT_CONFIG_VALUE_n inject configuration into every git
# invocation, and one `url.<other>.insteadOf` entry silently rewrites the push
# target no matter what this script computed. GIT_ALTERNATE_OBJECT_DIRECTORIES
# and GIT_NAMESPACE move objects and refs the same way. An environment that can
# redirect a push is an environment that can defeat the register, so this is a
# boundary and not a tidiness measure.
# Retires when: the client stops shelling out to git.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE \
      GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE \
      GIT_OBJECT_DIRECTORY GIT_COMMON_DIR 2>/dev/null || true
# GIT_CONFIG_KEY_n / GIT_CONFIG_VALUE_n are numbered, so they are unset by scan.
# Written with a case match rather than `sed -n 's/\(a\|b\)/'`, because BSD sed
# has no alternation in a basic regular expression and silently matches nothing:
# the first version of this loop stripped none of them and the test that proved
# it was the only reason anyone found out.
for __v in $(env | cut -d= -f1); do
  case "$__v" in
    GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$__v" 2>/dev/null || true ;;
  esac
done
unset __v 2>/dev/null || true

EX_OK=0
EX_FAIL=3
EX_RACE=4

PROG="hub"

# ---------------------------------------------------------------------------
# Paths. Derived from the script's own location so the client works from any
# working directory and never guesses at a checkout.
# ---------------------------------------------------------------------------

# BASH_SOURCE rather than $0, so the paths are right when the file is SOURCED
# with HUB_LIB=1: sourcing leaves $0 as the calling shell's name, which resolved
# the repository root to the parent of whatever directory the test ran in.
script_path=${BASH_SOURCE[0]:-$0}
case $script_path in
  */*) script_dir=$(cd "${script_path%/*}" && pwd) ;;
  *)   script_dir=$(pwd) ;;
esac
REPO_ROOT=$(cd "$script_dir/.." && pwd)
# The queue is at the repository root and NOT inside knowledge/. The OKF
# validator fails closed on a non-Markdown file inside a bundle, and operational
# state stays with its owning system rather than in the knowledge bundle.
# Retires when: the queue stops being a directory of files in this checkout.
QUEUE_DIR="$REPO_ROOT/queue"
CONFIG_FILE="$QUEUE_DIR/config.yaml"
ITEMS_DIR="$QUEUE_DIR/items"

# The object cache for the locks repository. Kept outside every checkout so a
# claim can never dirty a working tree, and so `git status` in metasalmon is
# never affected by hub traffic.
CACHE_DIR="${HUB_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/metasalmon-hub}"
LOCKS_DIR="$CACHE_DIR/locks.git"

# ---------------------------------------------------------------------------
# Output. Everything a human or a calling agent needs goes to stderr except the
# listings, which go to stdout so `hub ready` can be piped.
# ---------------------------------------------------------------------------

say()  { printf '%s\n' "$*" >&2; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
fail() { printf '%s: %s\n' "$PROG" "$*" >&2; exit "$EX_FAIL"; }

# ---------------------------------------------------------------------------
# The tiny YAML extractor.
#
# The queue schema is deliberately narrow so this can be exact rather than an
# approximation: one document per file, one scalar per line at column 0, and
# list values in inline flow style only. If a queue file ever needs nesting,
# the fix is a real parser or a narrower schema, not a cleverer awk.
# ---------------------------------------------------------------------------

yaml_scalar() { # file key -> value on stdout, empty if absent
  [ -f "$1" ] || return 0
  awk -v k="$2" -v sq="'" '
    index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      sub(/^[ \t]+/, "", v)
      sub(/[ \t]+#.*$/, "", v)     # a trailing comment needs whitespace before it,
      sub(/[ \t]+$/, "", v)        # so a quoted legacy value such as #53 survives
      n = length(v)
      if (n > 1) {
        a = substr(v, 1, 1); b = substr(v, n, 1)
        if ((a == "\"" && b == "\"") || (a == sq && b == sq)) v = substr(v, 2, n - 2)
      }
      print v
      exit
    }
  ' "$1"
}

yaml_flow_list() { # file key -> one element per line
  local raw
  raw=$(yaml_scalar "$1" "$2")
  raw=${raw#\[}
  raw=${raw%\]}
  printf '%s' "$raw" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//" | grep -v '^$'
  return 0
}

# The members block is the one nested structure the client reads, so it gets
# its own reader rather than a general one. It accepts both shapes the design
# has used: a mapping per member (repo, org, forge, solo) and a bare `org/repo`
# string, which is read as GitHub because that is what the string form meant.
# One line out per member: repo, org, forge, solo, tab separated.
#
# `solo` is empty when the entry does not state it, and empty means unstated
# rather than false: member_solo_for_repo is where an unstated value is
# resolved, because that is the one place the answer has to be conservative.
members_list() {
  [ -f "$CONFIG_FILE" ] || return 0
  awk -v sq="'" '
    function clean(s) {
      sub(/^[ \t]+/, "", s); sub(/[ \t]+#.*$/, "", s); sub(/[ \t]+$/, "", s)
      n = length(s)
      if (n > 1) {
        a = substr(s, 1, 1); b = substr(s, n, 1)
        if ((a == "\"" && b == "\"") || (a == sq && b == sq)) s = substr(s, 2, n - 2)
      }
      return s
    }
    function flush() {
      if (repo != "") printf "%s\t%s\t%s\t%s\n", repo, org, (forge == "" ? "github" : forge), solo
      repo = ""; org = ""; forge = ""; solo = ""
    }
    index($0, "members:") == 1 {
      rest = clean(substr($0, 9))
      if (index(rest, "[") == 1) {                     # inline flow of org/repo
        sub(/^\[/, "", rest); sub(/\]$/, "", rest)
        n = split(rest, parts, ",")
        for (i = 1; i <= n; i++) {
          p = clean(parts[i]); if (p == "") continue
          split(p, s, "/")
          if (s[2] != "") printf "%s\t%s\t%s\t%s\n", substr(p, length(s[1]) + 2), s[1], "github", ""
        }
        exit
      }
      inblock = 1; next
    }
    !inblock { next }
    /^[^ \t#]/ { flush(); exit }                       # the next key at column 0
    /^[ \t]*-/ {
      flush()
      line = $0; sub(/^[ \t]*-[ \t]*/, "", line); line = clean(line)
      if (line == "") next
      if (index(line, "repo:") == 1) { repo = clean(substr(line, 6)); next }
      if (index(line, "org:") == 1)  { org  = clean(substr(line, 5)); next }
      if (index(line, "solo:") == 1) { solo = clean(substr(line, 6)); next }
      split(line, s, "/")                              # bare org/repo string
      if (s[2] != "") { org = s[1]; repo = substr(line, length(s[1]) + 2); forge = "github"; flush() }
      next
    }
    /^[ \t]+[A-Za-z_]+:/ {
      line = clean($0)
      if (index(line, "repo:") == 1)  { repo  = clean(substr(line, 6)); next }
      if (index(line, "org:") == 1)   { org   = clean(substr(line, 5)); next }
      if (index(line, "forge:") == 1) { forge = clean(substr(line, 7)); next }
      if (index(line, "solo:") == 1)  { solo  = clean(substr(line, 6)); next }
    }
    END { flush() }
  ' "$CONFIG_FILE"
}

cfg() { yaml_scalar "$CONFIG_FILE" "$1"; }

cfg_required() { # key -> value, or exit 3 naming the key
  local v
  v=$(cfg "$1")
  if [ -z "$v" ]; then
    fail "configuration key '$1' is missing or empty in queue/config.yaml; this client hard-codes no value that the configuration carries"
  fi
  printf '%s' "$v"
}

# ---------------------------------------------------------------------------
# Configuration into ref names and URLs.
#
# Resolved once into globals rather than through a function called inside a
# command substitution. `fail` inside a substitution would only kill the
# subshell, and the caller would carry on with an empty remote URL, which is
# exactly the class of silent wrong-target failure the -u above guards against.
# ---------------------------------------------------------------------------

LOCKS_URL=""
LOCKS_URL_SOURCE=""
CLAIM_PREFIX=""

# HUB_LOCKS_URL is honoured ONLY while locks_repo is still the placeholder.
#
# It used to win unconditionally, which meant an environment variable could
# redirect every claim, heartbeat, release and handoff push at an arbitrary
# remote while the configuration named a real locks repository, silently, with
# nothing in the output saying where the pushes went. An override that can
# outrank a configured target is not an override, it is a redirect, and the
# whole value of this design is that the push target is the thing you can
# audit. So the override exists for exactly one window: the two-terminal race
# test in migration step 1, before the real repository exists.
#
# FIRST RETIREMENT CONDITION: MET. locks_repo named the real locks repository
# on 2026-09-10, so against the real queue the placeholder branch below is
# already unreachable and the refusal branch is the only one that runs. This
# comment used to stop at "Retires when: locks_repo names the real locks
# repository", which was the condition that had just been met, and a met
# retirement condition left in place is exactly the decay the rule against it
# exists to prevent: it reads as pending to anyone who does not go and check
# the configuration.
#
# Why the code is still here anyway, stated rather than left to be inferred:
# scripts/tests/test_hub_claim.sh builds its fixture queues with
# `locks_repo: PLACEHOLDER-...` and aims them at a throwaway bare repository
# with HUB_LOCKS_URL, because a fixture carrying a plausible remote could send
# a stray push somewhere real. Deleting the placeholder branch today would
# break every client assertion in that file. So the surviving reason is the
# test fixture and not the migration.
#
# Retires when: the fixtures in scripts/tests/test_hub_claim.sh stop needing
# the override -- they would point locks_repo at a `file://` URL, which
# resolve_locks_url already accepts unchanged -- and migration step 1 is signed
# off. At that point the PLACEHOLDER branch, the refusal branch, the two
# doctor branches and the HUB_LOCKS_URL row in HUB.md's writes register are
# deleted together, because none of them has a second reason to exist.
resolve_locks_url() { # -> sets LOCKS_URL and LOCKS_URL_SOURCE, or exits 3
  local repo override
  override=${HUB_LOCKS_URL:-}
  repo=$(cfg locks_repo)
  [ -n "$repo" ] || fail "configuration key 'locks_repo' is missing or empty; this client hard-codes no value that the configuration carries"

  case $repo in
    PLACEHOLDER*)
      # The configured value is a placeholder until Brett creates the locks
      # repository. Failing loudly here is the point: an agent that read
      # "nobody holds it" from a repository that does not exist would claim
      # work somebody else is already doing.
      if [ -n "$override" ]; then
        LOCKS_URL=$override
        LOCKS_URL_SOURCE="HUB_LOCKS_URL, permitted only because locks_repo is still the placeholder '$repo'"
        return 0
      fi
      fail "locks_repo is still the placeholder '$repo'. The locks repository does not exist yet; creating it and running the two-terminal race test is step 1 of the migration in section 9.7, and it is Brett's action. Set HUB_LOCKS_URL to test against a throwaway repository in the meantime" ;;
  esac

  if [ -n "$override" ]; then
    fail "HUB_LOCKS_URL is set to '$override' but locks_repo is the real value '$repo'. The override is honoured only while locks_repo is still the placeholder, because an environment variable that outranks a configured push target can redirect every claim, heartbeat, release and handoff at an arbitrary remote. Unset HUB_LOCKS_URL, or change locks_repo if the target really did move"
  fi

  case $repo in
    *://*|git@*) LOCKS_URL=$repo ;;
    */*)         LOCKS_URL="https://github.com/$repo.git" ;;
    *)           fail "locks_repo '$repo' is neither a URL nor an org/repo pair" ;;
  esac
  LOCKS_URL_SOURCE="queue/config.yaml locks_repo"
}

load_hub_config() {
  [ -n "$LOCKS_URL" ] && return 0
  [ -r "$CONFIG_FILE" ] || fail "queue/config.yaml is not readable"

  local p
  resolve_locks_url

  p=$(cfg claim_ref_prefix)
  [ -n "$p" ] || fail "configuration key 'claim_ref_prefix' is missing or empty"
  p=${p%/}
  case $p in
    refs/*) : ;;
    *) p="refs/heads/$p" ;;   # accept 'claim' as well as 'refs/heads/claim'
  esac
  CLAIM_PREFIX=$p
}

claim_ref() { printf '%s/%s' "$CLAIM_PREFIX" "$1"; }

# Every command that pushes says where it is about to push, and where that URL
# came from, before it pushes. A redirected push target is the one failure in
# this client that produces no error at all: the pushes succeed, at the wrong
# remote, and the queue looks healthy. Printing the effective URL first is what
# makes that visible in a transcript rather than only in a network trace.
#
# Retires when: nothing. This line costs one row of output and is the only
# evidence in the run of where the claim actually went.
LOCKS_URL_ANNOUNCED=0
announce_locks_url() {
  [ "$LOCKS_URL_ANNOUNCED" -eq 1 ] && return 0
  LOCKS_URL_ANNOUNCED=1
  say "locks repository: $LOCKS_URL"
  say "                  source: $LOCKS_URL_SOURCE"
}

# ---------------------------------------------------------------------------
# The agent token, and what makes it stable.
#
# The lock history is readable by anyone who can read the locks repository, so
# an internal machine name has no business in it. The token is an opaque random
# id, minted once and cached, so that every call in one agent session agrees
# about who this agent is.
#
# The token used to be keyed on $PPID, and that was wrong in a way that broke
# the protocol rather than merely looking untidy. A harness that spawns a fresh
# shell for every command gives each command a different parent, so each command
# minted a NEW identity: the agent could not recognise its own claim (`hub beat`
# reported the item held by somebody else), the concurrency cap counted zero
# every time, and `hub done` could not match the branch the grant covers.
#
# The session key ladder, in order, with what makes each one durable:
#
#   1. HUB_AGENT_TOKEN         the token itself, set by the caller. Stable
#                              because the caller says so.
#   2. HUB_SESSION_KEY         an explicit session key. Use this when a harness
#                              knows its own session identity and none of the
#                              variables below carry it.
#   3. a harness session id    CLAUDE_CODE_SESSION_ID, CODEX_SESSION_ID,
#                              AGENT_SESSION_ID. Set once when the session
#                              starts and inherited by every command in it,
#                              including the fresh shells a per-command harness
#                              spawns. This is the case the PPID key got wrong.
#   4. the controlling tty     stable across every shell in one terminal.
#                              Absent in a background or headless run, where
#                              ps(1) prints '??', so it is skipped there.
#   5. this machine and cache  the last resort. Stable forever, and therefore
#                              SHARED: two concurrent agents on one machine with
#                              none of 1-4 set would answer to the same identity,
#                              and the second would read the first's claim as its
#                              own. It warns for exactly that reason. Set
#                              HUB_SESSION_KEY when running agents in parallel.
#
# The key never reaches the lock history. It only names a local cache file, and
# it is digested first so the filename does not carry a session id either.
#
# Retires when: a harness-independent session id exists that every runner sets,
# at which point the ladder collapses to that one variable.
# ---------------------------------------------------------------------------

AGENT_TOKEN_SOURCE=""
SESSION_KEY=""

# Sets the SESSION_KEY and AGENT_TOKEN_SOURCE globals rather than printing,
# deliberately: a value read through a command substitution comes back from a
# subshell, and the assignment to AGENT_TOKEN_SOURCE would be lost there, which
# is exactly how doctor would end up reporting an empty token source.
session_key() {
  local v t
  if [ -n "${HUB_SESSION_KEY:-}" ]; then
    AGENT_TOKEN_SOURCE="HUB_SESSION_KEY"
    SESSION_KEY=$HUB_SESSION_KEY; return 0
  fi
  for v in CLAUDE_CODE_SESSION_ID CODEX_SESSION_ID AGENT_SESSION_ID; do
    eval "t=\${$v:-}"
    if [ -n "$t" ]; then
      AGENT_TOKEN_SOURCE="$v"
      SESSION_KEY=$t; return 0
    fi
  done
  t=$(ps -o tty= -p $$ 2>/dev/null | tr -d ' ')
  case ${t:-} in
    ''|'??'|'?') : ;;
    *) AGENT_TOKEN_SOURCE="the controlling terminal"; SESSION_KEY="tty-$t"; return 0 ;;
  esac
  AGENT_TOKEN_SOURCE="this machine and cache directory, shared by every agent here"
  SESSION_KEY="machine-default"
}

# A short digest of the key, so the cache filename carries no session id.
key_digest() {
  local d
  d=$(printf '%s' "$1" | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null || cksum; } | awk '{print $1}')
  [ -n "$d" ] || return 1
  printf '%s' "$(printf '%s' "$d" | cut -c1-16)"
}

agent_token() {
  local key file tok dg
  if [ -n "${HUB_AGENT_TOKEN:-}" ]; then
    AGENT_TOKEN_SOURCE="HUB_AGENT_TOKEN"
    tok=$HUB_AGENT_TOKEN
  else
    session_key
    key=$SESSION_KEY
    dg=$(key_digest "$key") || fail "cannot digest the session key; no shasum, sha256sum or cksum on PATH"
    file="$CACHE_DIR/session-$dg.token"
    if [ -f "$file" ]; then
      tok=$(cat "$file" 2>/dev/null)
    else
      mkdir -p "$CACHE_DIR" 2>/dev/null || fail "cannot create the cache directory"
      tok="a-$(LC_ALL=C od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
      [ "$tok" = "a-" ] && fail "cannot read /dev/urandom to mint an agent token"
      # The create is exclusive, and that is the whole point of this branch. Two
      # first calls in one session both find the cache empty, both mint, and a
      # plain `>` lets the second overwrite the first: the loser's claim then
      # names an identity that its own later beat, release and done calls cannot
      # recover, so the item reads as held by a stranger who is itself. `set -C`
      # opens with O_EXCL, so exactly one of them creates the file and every
      # other one reads what the winner wrote.
      # Retires when: the token stops being cached in a file, which is when a
      # harness-independent session id exists and the ladder above collapses.
      if ( set -C; printf '%s\n' "$tok" > "$file" ) 2>/dev/null; then
        case $key in
          machine-default)
            warn "no session identity was available, so this agent's token is keyed on the machine and the cache directory and is shared with every other agent running here. Set HUB_SESSION_KEY if more than one agent runs at a time" ;;
        esac
      else
        # Either another call in this session created it a moment ago, in which
        # case its value is the session's answer and this one adopts it, or the
        # file cannot be written at all, in which case there is nothing to read
        # and a token this call invented would not survive to the next command.
        tok=$(cat "$file" 2>/dev/null)
        [ -n "$tok" ] || fail "cannot write the agent token cache at $file, and there is no token there to read"
      fi
    fi
  fi
  case $tok in
    *[!A-Za-z0-9_-]*)
      fail "agent token '$tok' contains something other than letters, digits, dash and underscore; a hostname or an address must never reach the lock history" ;;
  esac
  case $tok in
    ????*) : ;;
    *) fail "agent token '$tok' is too short to identify a session" ;;
  esac
  printf '%s' "$tok"
}

# ---------------------------------------------------------------------------
# Time. ISO-8601 UTC in the record, epoch seconds for comparison. GNU and BSD
# date disagree about both directions, so detect once.
# ---------------------------------------------------------------------------

DATE_FLAVOR=unknown
if date -u -d '@0' +%s >/dev/null 2>&1; then
  DATE_FLAVOR=gnu
elif date -u -r 0 +%s >/dev/null 2>&1; then
  DATE_FLAVOR=bsd
fi

now_epoch() { date -u +%s; }

iso_from_epoch() {
  case $DATE_FLAVOR in
    gnu) date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ ;;
    bsd) date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ ;;
    *)   return 1 ;;
  esac
}

epoch_from_iso() { # prints epoch seconds; returns non-zero if it cannot parse
  case $DATE_FLAVOR in
    gnu) date -u -d "$1" +%s 2>/dev/null ;;
    bsd) date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null ;;
    *)   return 1 ;;
  esac
}

lease_hours() { # honours --batch / HUB_MODE=batch; interactive is the default
  local mode key v
  mode=${HUB_MODE:-interactive}
  [ "${HUB_BATCH:-0}" = "1" ] && mode=batch
  if [ "$mode" = "batch" ]; then key=lease_hours_batch; else key=lease_hours_interactive; fi
  v=$(cfg_required "$key") || exit $?
  printf '%s' "$v"
}

lease_until_now() { # -> ISO-8601 UTC lease expiry for a fresh or renewed lease
  local hours now until
  hours=$(lease_hours) || exit $?
  case $hours in *[!0-9.]*|'') fail "$hours is not a number of hours" ;; esac
  now=$(now_epoch)
  # Integer seconds only; a fractional lease hour is not a thing this needs.
  until=$(( now + $(printf '%.0f' "$hours") * 3600 ))
  iso_from_epoch "$until" || fail "this system's date(1) is neither GNU nor BSD flavoured, so a lease cannot be computed"
}

# ---------------------------------------------------------------------------
# The locks object cache, and the push classifier.
# ---------------------------------------------------------------------------

# Two hub processes in one session share this cache, so a cold start is raced
# too. Measured 2026-09-10 with the cap race in
# scripts/tests/test_hub_claim.sh: two `hub claim` calls against an empty cache
# both ran `git init --bare` on the same path and one of them exited 3 with
# "cannot initialise the local locks object cache", which reads like a broken
# machine rather than a lost race. So the failure of init is not the answer
# here; whether the directory is a usable repository afterwards is.
# Retires when: the client stops keeping a local object cache.
ensure_locks_cache() {
  local tries=0
  while [ "$tries" -lt 3 ]; do
    lg rev-parse --git-dir >/dev/null 2>&1 && return 0
    mkdir -p "$CACHE_DIR" || fail "cannot create the cache directory"
    git init --quiet --bare "$LOCKS_DIR" >/dev/null 2>&1
    tries=$((tries + 1))
    lg rev-parse --git-dir >/dev/null 2>&1 && return 0
    sleep 1
  done
  fail "cannot initialise the local locks object cache at $LOCKS_DIR"
}

lg() { git --git-dir="$LOCKS_DIR" "$@"; }

# ---------------------------------------------------------------------------
# The one lock git cannot provide: the concurrency cap.
#
# Every other rule in this protocol is a question about ONE ref, which is why
# the compare-and-swap argument above settles them. max_concurrent_claims is
# not: it counts this agent's live claims across every ref. Two `hub claim`
# processes for one agent on two different items both read a count of zero,
# both push, and each push is correct on its own, so the locks repository
# cannot refuse either one. Measured 2026-09-10 against a fixture with the cap
# set to 1: two claims, two refs, one agent, and nothing anywhere saying so
# (assertion 19 in scripts/tests/test_hub_claim.sh).
#
# So the read-count-push window is serialized locally, with an atomic mkdir in
# the cache directory that records the holder's pid. What that covers and what
# it does not, stated plainly, because a lock whose reach is assumed is worse
# than no lock:
#
#   covered      two hub processes that share this cache directory. That is
#                every pair that also shares an agent identity by the ladder
#                above, because the identity is derived from the same session
#                key and cached in that same directory. It is the case the
#                finding describes and the case a harness actually produces.
#   NOT covered  two processes carrying the same HUB_AGENT_TOKEN on two
#                machines, or pointed at two cache directories. There the cap
#                is still only a precheck and two claims can still land.
#
# The two constants below are mechanics of a local mutex, not queue policy:
# nothing in HUB.md cites them, no agent's behaviour is described by them, and
# changing either changes no rule. That is why they are here rather than in
# queue/config.yaml, which owns the constants that ARE rules. If either ever
# becomes something a person reads as a promise, it moves there with the rest.
#
# Retires when: the cap moves into the locks repository as a per-agent ref that
# a claim has to fast-forward. Then git arbitrates the cap the same way it
# already arbitrates the item, and this lock is deleted rather than tuned.
# ---------------------------------------------------------------------------

CAP_LOCK_DIR=""
CAP_LOCK_HELD=0
CAP_BREAK_DIR=""
CAP_BREAK_HELD=0
CAP_LOCK_WAIT_SECONDS=20
# Read only for a lock that records no holder; the no-pid branch below says why.
CAP_LOCK_STALE_SECONDS=120

path_age_seconds() { # path -> age in seconds, or non-zero when unmeasurable
  local m now
  m=$(stat -c %Y "$1" 2>/dev/null)          # GNU stat
  case ${m:-} in ''|*[!0-9]*) m=$(stat -f %m "$1" 2>/dev/null) ;; esac   # BSD stat
  case ${m:-} in ''|*[!0-9]*) return 1 ;; esac
  now=$(now_epoch)
  printf '%s' "$(( now - m ))"
}

# Whether a process id names a running process. kill -0 is the portable probe;
# its one false negative is a process this user may not signal, which ps(1)
# can still see. The cache directory is per user, so that case is rare here,
# and the fallback costs one ps on a path that only runs while a lock is
# contended. A recycled pid reads as alive, and the cost of that is a claim
# that exits 3 naming the lock rather than a claim that races: remove the
# directory by hand if the pid it names is not a hub process.
pid_alive() { # pid -> 0 alive, 1 not
  case ${1:-} in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null && return 0
  ps -p "$1" -o pid= 2>/dev/null | grep -q '[0-9]'
}

# The pid the lock records as its holder, or nothing when the file is absent
# or does not hold a number.
cap_lock_holder() { # -> pid on stdout, or nothing
  local p
  p=$(cat "$CAP_LOCK_DIR/pid" 2>/dev/null | tr -d ' \t\r\n')
  case ${p:-} in ''|*[!0-9]*) : ;; *) printf '%s' "$p" ;; esac
}

# 0 held, 2 another process held it for longer than the wait, 1 the lock could
# not be attempted at all. The caller turns 1 and 2 into a 3 with different
# words, because "somebody else is claiming right now" and "this machine cannot
# keep a lock" are different things to be told.
cap_lock_acquire() { # token -> 0, 1 or 2
  local token=$1 dg waited=0 age holder rc
  # Per agent, not per machine: two different agents on one machine have
  # separate caps and must not queue behind each other.
  dg=$(key_digest "$token") || return 1
  CAP_LOCK_DIR="$CACHE_DIR/cap-$dg.lock"
  CAP_BREAK_DIR="$CAP_LOCK_DIR.break"
  mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
  # The trap is set before either directory is, and covers both. `fail` exits
  # the process from inside a helper, and a lock nobody releases would stop
  # every later claim on this machine; a break lock nobody releases would stop
  # every later break. Cleared again on every return that holds nothing.
  trap 'cap_lock_release' EXIT
  while :; do
    if mkdir "$CAP_LOCK_DIR" 2>/dev/null; then
      # The holder's pid goes in before the lock counts as held. It is what a
      # waiter reads to tell an abandoned lock from a slow one, and what the
      # release below reads to be sure the lock it removes is still its own. A
      # lock with no holder recorded can be neither waited on correctly nor
      # released safely, so failing to write it is failing to take the lock.
      if ! printf '%s\n' "$$" > "$CAP_LOCK_DIR/pid" 2>/dev/null; then
        # rm -rf and not rmdir: the shell creates the file for the redirection
        # before anything is written, and a full disk fails the write and not
        # the create (mkdir needs only an inode), so rmdir fails on the file
        # it left behind and a lock with an empty pid survives, which every
        # later process waits out and blames on a holder that does not exist.
        # This process's mkdir created the directory a moment ago, so nobody
        # else can hold it.
        rm -rf "$CAP_LOCK_DIR" 2>/dev/null || true
        trap - EXIT
        return 1
      fi
      CAP_LOCK_HELD=1
      return 0
    fi
    # Somebody holds it. Whether they are still running is the question, and
    # the recorded pid answers it; the age of the directory does not. Until
    # 2026-09-10 age alone decided, at CAP_LOCK_STALE_SECONDS, and a holder
    # whose fetch, count and push under the lock took longer than that -- the
    # git calls in there have no timeout, so a slow remote is all it takes --
    # was judged dead while alive: the waiter broke the lock, took its own, and
    # both then pushed, which is the double claim this lock exists to stop. The
    # first holder's release then deleted the second's lock, and a third walked
    # in behind them. A live pid is now waited on for as long as the wait
    # allows and then reported, and is never broken.
    holder=$(cap_lock_holder)
    if [ -n "$holder" ]; then
      if pid_alive "$holder"; then
        [ "$waited" -lt "$CAP_LOCK_WAIT_SECONDS" ] || { trap - EXIT; return 2; }
        sleep 1; waited=$((waited + 1)); continue
      fi
      cap_lock_break "$holder" ""; rc=$?
    else
      # No pid recorded: the holder crashed between the mkdir and the write, or
      # is between them right now. Age is the only evidence left and it is
      # weak, so it is the secondary signal and applies only in this branch.
      # Retires when: the pid is recorded atomically with the lock, which mkdir
      # cannot do; a lock file created with O_EXCL and carrying the pid as its
      # content would retire this branch and path_age_seconds with it.
      age=$(path_age_seconds "$CAP_LOCK_DIR") || age=""
      if [ -z "$age" ] || [ "$age" -le "$CAP_LOCK_STALE_SECONDS" ]; then
        [ "$waited" -lt "$CAP_LOCK_WAIT_SECONDS" ] || { trap - EXIT; return 2; }
        sleep 1; waited=$((waited + 1)); continue
      fi
      cap_lock_break "" "$age"; rc=$?
    fi
    case $rc in
      0) continue ;;               # moved aside; the next mkdir is this one's to win or lose
      1) trap - EXIT; return 1 ;;  # fail closed; cap_lock_break said why
      *)
        # The break lock was somebody else's, the lock changed under the
        # re-read, or the rename was refused. All three mean read it again,
        # and all three charge the wait. A refused rename used to fall straight
        # back into the loop with no sleep and no count, which was a process
        # printing the break message hundreds of times a second for as long as
        # the cache directory stayed unwritable.
        [ "$waited" -lt "$CAP_LOCK_WAIT_SECONDS" ] || { trap - EXIT; return 2; }
        sleep 1; waited=$((waited + 1)) ;;
    esac
  done
}

# Moves an abandoned lock aside. This is the one step in the mutex that has to
# be a compare-and-swap and is not one by nature: deciding that the holder is
# dead and renaming whatever sits at CAP_LOCK_DIR are two steps, and until
# 2026-09-10 (fourth round) nothing joined them. Two waiters both read a dead
# pid; the first moved the lock aside, re-took it and recorded itself; the
# second, a few milliseconds behind, moved the first's live lock aside on the
# strength of its stale read. Two holders, two pushes, two claims against a cap
# of one. Measured at 2 of 30 rounds with nothing added and 10 of 10 with 20 ms
# between the decision and the rename, which is about what the ps fork in
# pid_alive costs for a dead pid; assertion 32 in scripts/tests/test_hub_claim.sh
# keeps that measurement.
#
# So the break is serialized by a second exclusive mkdir, and the decision is
# made again under it. The invariant is this: between that re-read and the
# rename nothing can replace the lock, because a live holder only ever removes
# its own lock and never replaces it, a new holder can appear only through
# mkdir, which fails while the lock exists, and every other breaker is waiting
# on this mkdir. The rename therefore moves exactly the lock that was re-read,
# and the pid found in the grave afterwards is the proof. A different pid means
# the invariant did not hold -- a client without this lock, a hand, a recycled
# pid -- and this process may have moved a live holder's lock, so it stops
# rather than claims, says where the lock went, and leaves it there.
#
# The break lock itself is never broken. It is held for a handful of syscalls
# and no git call, so one left behind means a breaker was killed inside them;
# every later waiter then runs out its budget and exits 3 naming it, and a
# human removes it. Breaking it by age would put a stopped breaker back into
# the middle of a rename it decided long ago, which is this defect again.
#
# 0 the lock was moved aside and the caller may try mkdir; 2 the break lock is
# somebody else's, the lock changed under the re-read, or the rename was
# refused, so wait and read again; 1 fail closed, the grave holds a pid this
# process did not decide on.
# Retires when: the cap leaves this directory mutex for a per-agent ref in the
# locks repository, which retires the mutex, the break lock and this function.
cap_lock_break() { # dead_pid age -> 0 moved aside, 1 fail closed, 2 read again
  local dead=$1 age=$2 holder now_age grave gpid
  mkdir "$CAP_BREAK_DIR" 2>/dev/null || return 2
  CAP_BREAK_HELD=1
  # Decide again, under the break lock, because the decision that brought this
  # process here was made without it and may be stale by now.
  holder=$(cap_lock_holder)
  if [ -n "$dead" ]; then
    if [ "$holder" != "$dead" ] || pid_alive "$holder"; then
      cap_break_release; return 2
    fi
  else
    now_age=$(path_age_seconds "$CAP_LOCK_DIR") || now_age=""
    if [ -n "$holder" ] || [ -z "$now_age" ] || [ "$now_age" -le "$CAP_LOCK_STALE_SECONDS" ]; then
      cap_break_release; return 2
    fi
  fi
  grave="$CAP_LOCK_DIR.dead.$$.$RANDOM"
  if ! mv "$CAP_LOCK_DIR" "$grave" 2>/dev/null; then
    cap_break_release; return 2
  fi
  cap_break_release
  # The proof that the rename moved the lock that was re-read and nothing else.
  gpid=$(cat "$grave/pid" 2>/dev/null | tr -d ' \t\r\n')
  if [ "$gpid" != "$dead" ]; then
    warn "stopping: the claim lock moved aside to $grave records pid ${gpid:-none}, and this process had decided to break a lock recording ${dead:-no holder}. Something outside this client changed the lock between the two, so a live holder's lock may have been moved; it is left there as evidence and this claim is not made"
    return 1
  fi
  if [ -n "$dead" ]; then
    warn "breaking the claim lock at $CAP_LOCK_DIR: its holder, pid $dead, is no longer running and did not release it"
  else
    warn "breaking the claim lock at $CAP_LOCK_DIR: it records no holder and is $age seconds old, so whatever took it did not get as far as saying so"
  fi
  rm -rf "$grave" 2>/dev/null || true
  return 0
}

cap_break_release() {
  [ "$CAP_BREAK_HELD" -eq 1 ] || return 0
  CAP_BREAK_HELD=0
  rmdir "$CAP_BREAK_DIR" 2>/dev/null || true
}

# Removes the lock only while its recorded holder is this process. A lock whose
# pid is somebody else's was broken and re-taken while this process held it,
# which means the serialization it was counting on did not hold and its claim
# may have raced; so it is left where it is and said out loud, because deleting
# it would hand the same hole to a third process. Releases the break lock first
# if this process died holding it, which is what the exit trap is for.
cap_lock_release() {
  local holder
  cap_break_release
  if [ "$CAP_LOCK_HELD" -ne 1 ]; then trap - EXIT; return 0; fi
  CAP_LOCK_HELD=0
  trap - EXIT
  holder=$(cap_lock_holder)
  if [ "$holder" = "$$" ]; then
    rm -rf "$CAP_LOCK_DIR" 2>/dev/null || true
  else
    warn "not releasing the claim lock at $CAP_LOCK_DIR: it records pid ${holder:-none} rather than this process ($$), so it was broken and re-taken while this process held it, and the cap check this process made may have raced the one that took it"
  fi
}

# Git's rejection vocabulary, in one place. Only these mean the ref moved.
# Anything else, including every authentication and transport failure, is 3.
is_race_output() {
  printf '%s' "$1" | grep -Eq '\[rejected\]|\[remote rejected\]' || return 1
  printf '%s' "$1" | grep -Eq 'non-fast-forward|fetch first|stale info|cannot lock ref|failed to update ref' || return 1
  return 0
}

HUB_GIT_OUT=""

push_ref() { # sha ref -> 0 pushed, 4 lost the race, 3 anything else
  local out rc
  out=$(lg push "$LOCKS_URL" "$1:$2" 2>&1); rc=$?
  HUB_GIT_OUT=$out
  [ $rc -eq 0 ] && return 0
  is_race_output "$out" && return "$EX_RACE"
  return "$EX_FAIL"
}

remote_tip() { # id -> prints sha; 0 present, 2 absent, 3 call failed
  local out rc
  out=$(git ls-remote --exit-code "$LOCKS_URL" "$(claim_ref "$1")" 2>&1); rc=$?
  case $rc in
    0) HUB_GIT_OUT=""; printf '%s\n' "$out" | awk 'NR==1{print $1}'; return 0 ;;
    2) HUB_GIT_OUT=""; return 2 ;;
    *) HUB_GIT_OUT=$out; return 3 ;;
  esac
}

fetch_one() { # id -> local mirror at refs/hub/claim/<id>
  local out rc
  out=$(lg fetch --quiet --no-tags "$LOCKS_URL" \
        "+$(claim_ref "$1"):refs/hub/claim/$1" 2>&1); rc=$?
  HUB_GIT_OUT=$out
  return $rc
}

fetch_all() { # every claim ref into refs/hub/claim/*, pruned
  local out rc
  out=$(lg fetch --quiet --prune --no-tags "$LOCKS_URL" \
        "+$CLAIM_PREFIX/*:refs/hub/claim/*" 2>&1); rc=$?
  HUB_GIT_OUT=$out
  return $rc
}

tip_field() { # id key -> value from the mirrored tip's claim.yaml
  local blob
  blob=$(lg show "refs/hub/claim/$1:claim.yaml" 2>/dev/null) || return 1
  printf '%s' "$blob" | awk -v k="$2" '
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }'
}

# The attempt counter, read defensively. A tip written by a future version of
# this client, or by hand, must not put a non-numeric value into arithmetic.
tip_attempt() { # id -> a non-negative integer, 0 when absent or unreadable
  local v
  v=$(tip_field "$1" attempt 2>/dev/null) || v=""
  case ${v:-} in
    ''|*[!0-9]*) printf '0' ;;
    *)           printf '%s' "$v" ;;
  esac
}

# The claim record. Exactly one file in the tree, exactly these five keys, in
# this order, plus branch and reason only where the action has one.
write_claim_commit() { # id action lease_until attempt [parent_sha] [branch] [reason] -> sha
  local id=$1 action=$2 lease=$3 attempt=$4 parent=${5:-} branch=${6:-} reason=${7:-}
  local body blob tree sha token
  token=$(agent_token) || exit $?
  body="id: $id
agent: $token
action: $action
lease_until: $lease
attempt: $attempt"
  [ -n "$branch" ] && body="$body
branch: $branch"
  if [ -n "$reason" ]; then
    reason=$(printf '%s' "$reason" | tr '\n\r' '  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    body="$body
reason: $reason"
  fi
  blob=$(printf '%s\n' "$body" | lg hash-object -w --stdin) || return 1
  tree=$(printf '100644 blob %s\tclaim.yaml\n' "$blob" | lg mktree) || return 1
  # The identity is the token, never the machine's git configuration: the lock
  # history must not carry a personal address any more than a hostname.
  GIT_AUTHOR_NAME="hub-agent" GIT_AUTHOR_EMAIL="$token@agents.invalid" \
  GIT_COMMITTER_NAME="hub-agent" GIT_COMMITTER_EMAIL="$token@agents.invalid" \
  lg commit-tree "$tree" ${parent:+-p "$parent"} -m "$action $id by $token" || return 1
}

# ---------------------------------------------------------------------------
# Queue items.
# ---------------------------------------------------------------------------

item_file() { printf '%s/%s.yaml' "$ITEMS_DIR" "$1"; }

item_exists() { [ -f "$(item_file "$1")" ]; }

item_field() { yaml_scalar "$(item_file "$1")" "$2"; }

items_all() { # ids, C-sorted
  [ -d "$ITEMS_DIR" ] || return 0
  ls "$ITEMS_DIR" 2>/dev/null | sed -n 's/\.yaml$//p' | sort
}

# An item blocks unless it is done. An id with no file also blocks, and says
# so: a dangling blocked_by is a queue defect, not a green light.
blockers_of() { # id -> one unresolved blocker per line, "<id> (<why>)"
  local b st
  for b in $(yaml_flow_list "$(item_file "$1")" blocked_by); do
    if ! item_exists "$b"; then
      printf '%s (no such queue item)\n' "$b"
      continue
    fi
    st=$(item_field "$b" state)
    [ "$st" = "done" ] || printf '%s (%s)\n' "$b" "${st:-no state}"
  done
}

member_forge_for_repo() { # repo -> forge, or empty when it is not a member
  members_list | awk -F'\t' -v r="$1" '$1 == r { print $3; exit }'
}

member_slug_for_repo() { # repo -> org/repo, or empty when it is not a member
  members_list | awk -F'\t' -v r="$1" '$1 == r { print $2 "/" $1; exit }'
}

# Whether nobody but Brett has ever contributed to a member repository, read
# from that member's `solo:` entry in queue/config.yaml and from nowhere else.
#
# HUB.md's participation table under "The standing authorization" is the
# authority for this fact and the configuration column is its machine-readable
# copy; `hub_queue.py lint` fails when the two disagree, and fails again when
# a member omits the key. This function used to hold a third copy: a
# hard-coded list of the solo members, consulted for any entry the key had
# not reached, which resolved an absent or unrecognised value to `yes` for
# every repository on it. Its retirement condition was that every member
# state `solo:`, and that was met one commit after the list was written
# (ee5e0cc added the list, ae02441 the column, both 2026-09-10), so the list
# outlived its reason by exactly one review round. It is deleted rather than
# kept dormant, because dormant is the one thing it could not be: for an
# entry the key was later dropped from, or mistyped, it would have told an
# agent to push a branch and open a pull request on the strength of nothing
# the configuration said, which is the opposite of the rule it stood in for.
#
# So the only source is the entry, and every answer the entry does not give
# is `no`: an absent key, a value that is neither true nor false, a
# repository that is not a member at all, and an item with no repo field.
# HUB.md: when in doubt, it is shared. The two ways of being wrong do not
# cost the same, and this is the cheap one.
#
# Retires when: the grant stops being scoped by participation, at which point
# this function, the claim-time paragraph in claim_count_and_push, the
# hand-back paragraph in cmd_done and the doctor line that counts the answers
# are deleted together.
member_solo_for_repo() { # repo -> yes only when the entry says so, otherwise no
  local declared
  declared=$(members_list | awk -F'\t' -v r="$1" '$1 == r { print $4; exit }')
  case $declared in
    true|yes|True|TRUE|Yes|YES) printf 'yes' ;;
    *)                          printf 'no' ;;
  esac
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
  local ok=0 v url out rc token prefix probe sha declared solo_n r
  say "$PROG doctor"
  say ""

  v=${BASH_VERSION:-unknown}
  case $v in
    [12].*|unknown) say "FAIL  bash $v; this script needs 3.2 or newer"; ok=1 ;;
    *)              say "ok    bash $v" ;;
  esac

  if command -v git >/dev/null 2>&1; then
    say "ok    $(git --version)"
  else
    say "FAIL  git is not on PATH"; ok=1
  fi

  case $DATE_FLAVOR in
    gnu|bsd) say "ok    date(1) is $DATE_FLAVOR flavoured" ;;
    *)       say "FAIL  date(1) is neither GNU nor BSD flavoured; leases cannot be computed"; ok=1 ;;
  esac

  if [ -r "$CONFIG_FILE" ]; then
    say "ok    queue/config.yaml is readable"
    # Every operating constant the client reads. queue/config.yaml is the only
    # home for all of them, so a key missing here is a cap or a lease that
    # nothing enforces, and this loop is where that becomes visible.
    # Retires when: the client stops reading a key, at which point it comes out
    # of this list in the same change.
    for v in locks_repo claim_ref_prefix lease_hours_interactive lease_hours_batch \
             heartbeat_minutes reclaim_grace_minutes max_concurrent_claims \
             max_reclaims_per_item_per_day; do
      if [ -z "$(cfg "$v")" ]; then
        say "FAIL  config $v is missing or empty, so the rule it carries is enforced nowhere"
        case $v in
          max_reclaims_per_item_per_day)
            say "      HUB.md's writes register cites this limit and hub claim enforces it on the"
            say "      reclaim path, so a reclaim exits 3 until queue/config.yaml carries the key."
            say "      Add: max_reclaims_per_item_per_day: 1" ;;
        esac
        ok=1
        continue
      fi
      # The placeholder is reported here rather than left to load_hub_config,
      # so doctor states it as a finding instead of exiting mid-check.
      case "$v=$(cfg "$v")" in
        locks_repo=PLACEHOLDER*)
          if [ -n "${HUB_LOCKS_URL:-}" ]; then
            say "ok    config locks_repo is a placeholder, overridden by HUB_LOCKS_URL for this run only because it is a placeholder"
          else
            say "FAIL  config locks_repo is still a placeholder; the locks repository does not exist yet, and creating it is migration step 1 and Brett's action"
            ok=1
          fi
          continue ;;
      esac
      # A real locks_repo makes the override inert, and a set-but-ignored
      # variable is worth one line rather than a silent surprise later.
      case "$v" in
        locks_repo)
          if [ -n "${HUB_LOCKS_URL:-}" ]; then
            say "FAIL  HUB_LOCKS_URL is set but locks_repo is the real value '$(cfg locks_repo)'; the override is honoured only while locks_repo is a placeholder, and every push command will refuse until it is unset"
            ok=1
            continue
          fi ;;
      esac
      say "ok    config $v = $(cfg "$v")"
    done
    v=$(members_list | grep -c .)
    say "ok    config members lists $v repositories"
    # The participation answer per member, counted through the same function
    # every command uses, because it is the one fact the standing grant turns
    # on and a doctor that computed it a second way would be a second copy.
    # An entry that does not state `solo:` is counted as shared and named as
    # unstated, so the omission is visible here as well as in the lint that
    # fails on it. This line used to count down to the deletion of a fallback
    # list in this script; the list is gone, and so is the countdown.
    # Retires when: the grant stops being scoped by participation, which is
    # what retires member_solo_for_repo.
    solo_n=0
    for r in $(members_list | cut -f1); do
      [ "$(member_solo_for_repo "$r")" = "yes" ] && solo_n=$((solo_n + 1))
    done
    declared=$(members_list | awk -F'\t' '$4 != ""' | grep -c .)
    say "ok    config $solo_n of $v members are solo; the other $((v - solo_n)) are read as shared"
    if [ "$declared" -lt "$v" ]; then
      say "      $((v - declared)) of those because the entry does not state solo: at all, which"
      say "      is shared by HUB.md's rule and is a failure in hub_queue.py lint"
    fi
  else
    say "FAIL  queue/config.yaml is not readable"; ok=1
  fi

  if [ -d "$ITEMS_DIR" ]; then
    v=$(items_all | wc -l | tr -d ' ')
    say "ok    queue/items holds $v item files"
  else
    say "FAIL  queue/items does not exist"; ok=1
  fi

  if token=$(agent_token 2>/dev/null); then
    say "ok    agent token $token, checked for the characters a hostname or an address would need"
    # Which rung of the ladder produced it, because that is what decides whether
    # this agent will still be the same agent on its next command. Recomputed in
    # this shell: the call above ran in a subshell, so its assignment to the
    # global did not survive.
    if [ -n "${HUB_AGENT_TOKEN:-}" ]; then
      AGENT_TOKEN_SOURCE="HUB_AGENT_TOKEN"
    else
      session_key
    fi
    say "ok    token keyed on $AGENT_TOKEN_SOURCE"
    case $AGENT_TOKEN_SOURCE in
      "this machine and cache directory"*)
        say "      that key is shared with every agent running here; set HUB_SESSION_KEY before running two at once" ;;
    esac
  else
    say "FAIL  no usable agent token; see the message from the next call for the reason"; ok=1
  fi

  if [ "$ok" -ne 0 ]; then
    say ""
    say "Stopping before the network checks: the local ones above have to pass first."
    return "$EX_FAIL"
  fi

  load_hub_config
  announce_locks_url
  ensure_locks_cache
  url=$LOCKS_URL
  prefix=$CLAIM_PREFIX
  out=$(git ls-remote --heads "$url" 2>&1); rc=$?
  if [ $rc -eq 0 ]; then
    v=$(printf '%s\n' "$out" | awk -v p="$prefix/" '$2 != "" && index($2, p) == 1' | grep -c . )
    say "ok    locks repository reachable for reading; $(printf '%s\n' "$out" | grep -c .) refs, $v under the claim prefix"
  else
    say "FAIL  cannot read the locks repository: $(printf '%s' "$out" | head -3 | tr '\n' ' ')"
    ok=1
  fi

  if [ "$ok" -eq 0 ]; then
    # A dry-run push still negotiates with git-receive-pack, which is the
    # endpoint that requires write permission, so this detects a read-only or
    # expired credential without creating anything.
    probe="${prefix}/_doctor-probe-$(agent_token)"
    if sha=$(write_claim_commit "_doctor-probe" claim "$(iso_from_epoch "$(now_epoch)")" 0 2>/dev/null); then
      out=$(lg push --dry-run "$url" "$sha:$probe" 2>&1); rc=$?
      if [ $rc -eq 0 ]; then
        say "ok    the claim prefix accepts a push (dry run; nothing was created)"
      elif is_race_output "$out"; then
        say "ok    the claim prefix accepts a push (the probe ref was rejected as non-fast-forward, which still proves write access)"
      else
        say "FAIL  a dry-run push under the claim prefix was refused: $(printf '%s' "$out" | head -3 | tr '\n' ' ')"
        ok=1
      fi
    else
      say "FAIL  cannot build a probe commit in the local object cache"; ok=1
    fi
  fi

  say ""
  say "Not verified by this run, and stated rather than assumed:"
  say "  - that a real ref creation under the claim prefix is permitted. Only a"
  say "    real push exercises a ruleset or branch protection; a dry run does not."
  say "  - that the member repositories in the configuration are reachable or"
  say "    writable. This client never pushes to them; the agent does that itself."
  say "  - that this machine's clock agrees with anyone else's. Every lease"
  say "    comparison in here trusts the local clock."
  say "  - that any lease constant is calibrated. They are guesses until twenty"
  say "    claims have been recorded and the result written down."

  # 0 or 3, never 1: the exit codes of this client are a contract, and doctor
  # is the command most likely to be read by a script rather than a person.
  [ "$ok" -eq 0 ] || return "$EX_FAIL"
  return "$EX_OK"
}

# ---------------------------------------------------------------------------
# ready
# ---------------------------------------------------------------------------

cmd_ready() {
  local set_id="" auth="" id st cl bl held ref hid hact grace now lu
  while [ $# -gt 0 ]; do
    case $1 in
      --set)   shift; [ $# -gt 0 ] || fail "--set needs an item id"; set_id=$1 ;;
      --set=*) set_id=${1#--set=} ;;
      --authorization)   shift; [ $# -gt 0 ] || fail "--authorization needs the words Brett used"; auth=$1 ;;
      --authorization=*) auth=${1#--authorization=} ;;
      *)       fail "ready: unknown argument '$1'" ;;
    esac
    shift
  done

  # --set prints the promotion; it does not make it.
  #
  # It used to say the reason was that "agents are forbidden to push main", and
  # both halves of that sentence were false from 2026-09-10: ruling R15 permits
  # an agent to push a small mechanical change to the default branch, and
  # permits an agent to promote an item on an authorization Brett gave in chat
  # as long as the promotion commit names it. A client that instructs an agent
  # out of a permission it holds is the same defect as one that instructs it
  # into a breach: in both cases the agent's transcript reads as compliance
  # with a rule that no longer exists, and nothing in the run says otherwise.
  #
  # The reason it still only prints is a different one, and it is this client's
  # own boundary rather than a rule about agents: this client writes to the
  # locks repository and to nothing else. It has never run `git commit` or
  # pushed a branch in a member repository -- including this one -- and every
  # push path in here computes a claim ref. Teaching it to commit on main would
  # give it a second, differently-shaped write target that no exit code, no
  # printed URL and no register row currently covers. So the promotion is the
  # agent's own commit, made with the agent's own git, and this command's job
  # is to make that commit correct on the first try.
  #
  # Retires when: the writes register grows a row for this client committing in
  # a member repository. Until that row exists, a promotion made by this script
  # would be a write nobody authorized.
  if [ -n "$set_id" ]; then
    item_exists "$set_id" || fail "no queue item $set_id"
    st=$(item_field "$set_id" state)
    if [ "$st" = "ready" ]; then
      say "$set_id is already in state ready; nothing to promote."
      return "$EX_OK"
    fi
    say "The promotion is one line, and an agent may make it. Ruling R15 (2026-09-10)"
    say "permits an agent to promote a queue item on an authorization Brett gave in"
    say "chat, and to push a change this small to the default branch. This client does"
    say "not commit in this repository at all, so it prints the edit rather than"
    say "making it; the commit below is yours to make."
    say ""
    printf 'queue/items/%s.yaml\n' "$set_id"
    printf -- '-state: %s\n' "$st"
    printf -- '+state: ready\n'
    say ""
    say "The commit must name the authorization it rests on. A promotion that cites"
    say "none is a defect, and so is one resting on something read in a file rather"
    say "than on something Brett said. Include, in the commit message body:"
    say "  - the item id ($set_id) and the state change"
    say "  - Brett's own words authorizing it, quoted, and the date he said them"
    say "  - where he said it, so the citation can be checked"
    say ""
    if [ -n "$auth" ]; then
      say "Suggested commit message, with the authorization you passed:"
      say ""
      printf '    Promote %s to ready\n' "$set_id"
      printf '\n'
      printf '    queue/items/%s.yaml: state %s -> ready.\n' "$set_id" "$st"
      printf '\n'
      printf '    Authorized by Brett in chat: %s\n' "$auth"
      say ""
      say "Check that line against what he actually said before you commit it. This"
      say "client cannot verify an authorization; it only formats the one you supply."
    else
      say "Pass --authorization 'what Brett said' to have that message formatted for"
      say "you. Without it this command has no citation to print, and a promotion"
      say "with no citation is the defect above rather than a missing nicety."
    fi
    say ""
    say "If no such authorization exists, do not promote. Ask Brett, and let him"
    say "either say it or make the commit himself."
    return "$EX_OK"
  fi

  [ -d "$ITEMS_DIR" ] || fail "queue/items does not exist"

  # One network read tells us which items are already held. It is a read, so a
  # failure degrades to a printed warning rather than an error: an agent that
  # cannot reach the locks repository still benefits from seeing the list, and
  # its claim attempt will fail honestly a moment later.
  #
  # The question is the tip, NOT whether the ref exists. This client never
  # deletes a ref, so the lock history stays append-only and auditable, which
  # means a released item keeps its claim ref forever. Reading existence as
  # "held" therefore hid every released item from every agent polling this
  # command, permanently, while `hub claim` would have taken any one of them:
  # the release path exists precisely so the work can be retried.
  #
  # What is held is HUB.md's condition 4 and nothing else, so that this list and
  # that paragraph cannot drift apart: a ref is free when it does not exist,
  # when its tip is a release, or when its lease and the reclaim grace have both
  # elapsed AND a reclaim is permitted under max_reclaims_per_item_per_day.
  # Everything else is held, including a handoff however old its lease, an
  # action this client did not write, a tip it cannot read at all, and an
  # expired claim whose reclaim cap is already spent, because a tip that cannot
  # be ruled out cannot be offered and a claim the client will refuse is not an
  # offer either.
  #
  # The cap half was missing until 2026-09-10: this listed every expired claim
  # once its grace had elapsed, while `hub claim` on the same item exited 3 at
  # the cap, so a polling agent kept selecting work the client would not give
  # it. Both commands now ask reclaim_cap_status, the one place the rule lives.
  # The holder's own expired claim stays held here too, although `hub claim`
  # would renew it: this listing has never asked who is asking, and an agent
  # that holds an item does not need a list to tell it so.
  #
  # This is a listing, so where it cannot tell it says held: an unparseable
  # lease, a missing reclaim_grace_minutes or max_reclaims_per_item_per_day, or
  # a history that cannot be read hides the item rather than advertising work
  # whose claim would then be refused.
  # Retires when: claim refs are deleted on release, which would make existence
  # the right question again and is a change to the append-only rule.
  held=""
  load_hub_config
  ensure_locks_cache
  if fetch_all; then
    grace=$(cfg reclaim_grace_minutes)
    case ${grace:-} in ''|*[!0-9]*) grace="" ;; esac
    now=$(now_epoch)
    for ref in $(lg for-each-ref --format='%(refname)' refs/hub/claim/ 2>/dev/null); do
      hid=${ref##*/}
      hact=$(tip_field "$hid" action) || hact=""
      case ${hact:-unreadable} in
        release) continue ;;
        claim|beat|reclaim)
          if [ -n "$grace" ] && lu=$(epoch_from_iso "$(tip_field "$hid" lease_until)" 2>/dev/null) &&
             [ "$now" -ge $(( lu + grace * 60 )) ] && reclaim_cap_status "$hid" "$now"; then
            continue
          fi ;;
      esac
      held="$held$hid
"
    done
  else
    warn "could not read the locks repository, so held items are not filtered out: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"
  fi

  for id in $(items_all); do
    st=$(item_field "$id" state)
    [ "$st" = "ready" ] || continue
    cl=$(item_field "$id" claimable)
    [ "$cl" = "true" ] || continue
    bl=$(blockers_of "$id" | tr '\n' ' ')
    if [ -n "$(printf '%s' "$bl" | tr -d ' ')" ]; then continue; fi
    if [ -n "$held" ] && printf '%s\n' "$held" | grep -qx "$id"; then continue; fi
    printf '%-8s %-4s %-5s %s\n' \
      "$id" "$(item_field "$id" severity)" "$(item_field "$id" stream)" "$(item_field "$id" title)"
  done
  return "$EX_OK"
}

# ---------------------------------------------------------------------------
# claim
# ---------------------------------------------------------------------------

# Requires a fresh fetch_all. Prints a count on stdout and returns 0, or
# returns non-zero when the count cannot be determined.
#
# Every path that used to shrug and `continue` now returns non-zero instead. A
# tip this client cannot read is a tip it cannot rule out, and a cap computed
# from a count that skipped the refs it could not parse is not a cap, it is a
# number that happens to be small. The caller turns a non-zero return into a 3.
count_my_live_claims() {
  local ref id token now n=0 lu act ag refs
  token=$(agent_token) || return 1
  now=$(now_epoch)
  refs=$(lg for-each-ref --format='%(refname)' refs/hub/claim/ 2>/dev/null) || return 1
  for ref in $refs; do
    id=${ref##*/}
    ag=$(tip_field "$id" agent) || return 1
    [ "$ag" = "$token" ] || continue
    act=$(tip_field "$id" action) || return 1
    case $act in claim|beat|reclaim) : ;; *) continue ;; esac
    lu=$(epoch_from_iso "$(tip_field "$id" lease_until)" 2>/dev/null) || return 1
    [ "$lu" -gt "$now" ] && n=$((n + 1))
  done
  printf '%s' "$n"
}

# How many reclaim records this item's history carries since a given epoch.
# Requires a fresh fetch_one for the id. Prints a count and returns 0, or
# returns non-zero when the history cannot be read, which the caller turns
# into a 3 rather than a reclaim.
#
# The action is read from each commit's own claim.yaml rather than from its
# message, because the message is a convenience and the record is the record.
reclaims_since() { # id epoch -> count
  local id=$1 since=$2 sha ct act n=0 log
  log=$(lg log --format='%H %ct' "refs/hub/claim/$id" 2>/dev/null) || return 1
  while IFS=' ' read -r sha ct; do
    [ -n "$sha" ] || continue
    case ${ct:-} in ''|*[!0-9]*) return 1 ;; esac
    # The log is newest first, so the first commit older than the window ends it.
    [ "$ct" -ge "$since" ] || break
    act=$(lg show "$sha:claim.yaml" 2>/dev/null | awk '
      index($0, "action:") == 1 { v = substr($0, 8); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }')
    [ "$act" = "reclaim" ] && n=$((n + 1))
  done <<EOF
$log
EOF
  printf '%s' "$n"
}

# The reclaim cap, asked as one question in one place, because two commands
# need the same answer and had two answers until 2026-09-10. `hub claim` asked
# it before writing a reclaim; `hub ready` did not ask it at all and listed
# every expired claim once its grace had elapsed, so a polling agent selected
# an item the client then refused with an exit 3 at the cap. HUB.md's
# condition 4 says free means "a reclaim is permitted under the cap", and a
# listing that applies half of a condition lists the wrong set.
#
# Requires a fresh fetch of the id's ref. Returns 0 when a reclaim is under
# the cap, 1 when it is at the cap, and 2 when the cap cannot be verified:
# the key is missing or not a number, or the history cannot be read. Sets
# RECLAIM_CAP and RECLAIM_COUNT for the caller's message, RECLAIM_COUNT empty
# on a 2. The callers say different things about one answer -- claim exits 3
# with the reason, ready silently keeps the item held -- which is why the
# words are theirs and the rule is here.
# Retires when: reclaims stop being written by this client, which retires the
# cap with them.
RECLAIM_CAP=""
RECLAIM_COUNT=""
reclaim_cap_status() { # id now -> 0 under the cap, 1 at the cap, 2 cannot tell
  local id=$1 now=$2
  RECLAIM_CAP=$(cfg max_reclaims_per_item_per_day)
  RECLAIM_COUNT=""
  case ${RECLAIM_CAP:-} in ''|*[!0-9]*) return 2 ;; esac
  RECLAIM_COUNT=$(reclaims_since "$id" $(( now - 86400 ))) || { RECLAIM_COUNT=""; return 2; }
  [ "$RECLAIM_COUNT" -lt "$RECLAIM_CAP" ] && return 0
  return 1
}

cmd_claim() {
  local id=$1 token tip rc act ag lu now grace blk parent attempt
  item_exists "$id" || fail "no queue item $id; the queue is queue/items"
  [ "$(item_field "$id" claimable)" = "true" ] \
    || fail "$id is not claimable: it needs a decision or a credential that only Brett has"
  [ "$(item_field "$id" state)" = "ready" ] \
    || fail "$id is in state '$(item_field "$id" state)', and only a ready item can be claimed"
  blk=$(blockers_of "$id" | tr "\n" ";")
  [ -z "$(printf "%s" "$blk" | tr -d ";")" ] || fail "$id is blocked by ${blk%;}"

  token=$(agent_token) || exit $?
  load_hub_config
  announce_locks_url
  ensure_locks_cache
  now=$(now_epoch)

  tip=$(remote_tip "$id"); rc=$?
  case $rc in
    3) warn "cannot read the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac

  attempt=1
  parent=""
  if [ $rc -eq 0 ]; then
    fetch_one "$id" || { warn "cannot fetch the claim ref: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL"; }
    parent=$tip
    act=$(tip_field "$id" action)
    ag=$(tip_field "$id" agent)
    lu=$(epoch_from_iso "$(tip_field "$id" lease_until)" 2>/dev/null || printf '0')

    if [ "$act" = "handoff" ]; then
      # Finished work waits for Brett. A handoff tip is never claimable and is
      # never reclaimed, so the item does not look free again while he is away.
      warn "$id was handed off by $ag and is waiting for Brett to merge; a handoff is never reclaimed"
      return "$EX_RACE"
    fi

    if [ "$ag" = "$token" ] && [ "$act" != "release" ]; then
      if [ "$lu" -gt "$now" ]; then
        say "$id is already held by this agent until $(tip_field "$id" lease_until)"
        return "$EX_OK"    # idempotent: claiming what you hold succeeds quietly
      fi
      # The same agent, but its lease has run out. Reporting success on the
      # strength of the token alone told the caller it still held the item while
      # another agent was already eligible to reclaim it after the grace, so two
      # agents could work the item at once and neither would ever be told. The
      # answer is not a message: it is a record. The lease is renewed as a child
      # of the tip that was just read, so if a reclaim landed first the ref has
      # moved, the push is refused, and this call returns 4 instead of a 0 that
      # was never true.
      #
      # max_reclaims_per_item_per_day is deliberately not consulted. That limit
      # counts one agent taking work away from another; this is the same agent
      # extending its own record, and counting it here would punish a session
      # for the harness pausing it.
      warn "$id is claimed by this agent but the lease ran out at $(tip_field "$id" lease_until); renewing it against the ref rather than reporting a hold this agent may no longer have"
      attempt=$(( $(tip_attempt "$id") + 1 ))
      act=beat
    elif [ "$act" != "release" ] && [ "$ag" != "$token" ]; then
      if [ "$lu" -gt "$now" ]; then
        warn "$id is held by $ag until $(tip_field "$id" lease_until)"
        return "$EX_RACE"
      fi
      grace=$(cfg_required reclaim_grace_minutes) || return $?
      if [ "$now" -lt $(( lu + grace * 60 )) ]; then
        warn "$id has an expired lease from $ag, but the $grace minute reclaim grace has not passed yet"
        return "$EX_RACE"
      fi
      # max_reclaims_per_item_per_day, enforced here because this is the only
      # place a reclaim is written, and asked through the same function that
      # `hub ready` asks, so the two cannot disagree about which items are
      # free. The register in HUB.md cites this limit, and a register that
      # promises a limit nothing applies is worse than no limit: it reads as a
      # guarantee to everyone who is not holding the source.
      # Retires when: reclaims stop being written by this client.
      reclaim_cap_status "$id" "$now"; rc=$?
      case $rc in
        0) : ;;
        1) warn "$id has been reclaimed $RECLAIM_COUNT times in the last 24 hours and max_reclaims_per_item_per_day is $RECLAIM_CAP. An item that keeps being reclaimed is an item that keeps defeating agents; report it rather than taking it again"
           return "$EX_FAIL" ;;
        *) case ${RECLAIM_CAP:-} in
             '')       warn "configuration key 'max_reclaims_per_item_per_day' is missing or empty in queue/config.yaml; this client hard-codes no value that the configuration carries" ;;
             *[!0-9]*) warn "max_reclaims_per_item_per_day is '$RECLAIM_CAP', which is not a whole number" ;;
             *)        warn "cannot read the claim history of $id, so max_reclaims_per_item_per_day could not be verified; an unverifiable precondition is a failure and not a silent allowance" ;;
           esac
           return "$EX_FAIL" ;;
      esac
      attempt=$(( $(tip_attempt "$id") + 1 ))
      act=reclaim
    else
      act=claim
    fi
  else
    act=claim   # ref absent: the first claim, and it must be an orphan
  fi

  # Count and push under the local claim lock. The lock has to span both: a cap
  # checked before it and a push made after it is the same precheck this
  # serialization exists to replace.
  cap_lock_acquire "$token"; rc=$?
  case $rc in
    0) : ;;
    2) warn "another hub process for this agent, pid $(h=$(cap_lock_holder); printf '%s' "${h:-unrecorded}"), has held the claim lock at $CAP_LOCK_DIR for more than $CAP_LOCK_WAIT_SECONDS seconds, or the lock could not be broken or taken over in that time, so max_concurrent_claims could not be enforced without racing it. An unverifiable precondition is a failure and not a silent allowance. If that pid is not a hub process the lock is a leftover, and if $CAP_BREAK_DIR exists with no hub process running a breaker died holding it; either can be removed by hand"
       return "$EX_FAIL" ;;
    *) warn "cannot take the local claim lock under $CACHE_DIR, so max_concurrent_claims could not be enforced. An unverifiable precondition is a failure and not a silent allowance"
       return "$EX_FAIL" ;;
  esac
  claim_count_and_push "$id" "$act" "$attempt" "$parent" "$token"; rc=$?
  cap_lock_release
  return $rc
}

# The body of a claim, from counting this agent's live claims to pushing the
# record. Its own function for one reason: the caller holds a lock across it, so
# there must be exactly one place the lock is released, and a `return` buried in
# the middle of cmd_claim would have been a leak waiting for the next edit.
claim_count_and_push() { # id action attempt parent token
  local id=$1 act=$2 attempt=$3 parent=$4 token=$5
  local cap n lease sha rc itemrepo solo

  # Every branch below is a 3, including the two that used to be an allowance: a
  # cap that is not configured and a count that cannot be determined are both
  # unverified preconditions, and an unverified precondition is a failure. The
  # value lives in queue/config.yaml and nowhere else.
  # Retires when: the cap is deleted from the configuration deliberately, which
  # is a different act from it being absent by accident and is what this branch
  # cannot tell apart.
  cap=$(cfg max_concurrent_claims)
  case ${cap:-} in
    '')
      warn "max_concurrent_claims is missing or empty in queue/config.yaml, so the cap cannot be checked. An unverifiable precondition is a failure and not a silent allowance, so this claim stops here"
      return "$EX_FAIL" ;;
    *[!0-9]*)
      warn "max_concurrent_claims is '$cap', which is not a whole number"
      return "$EX_FAIL" ;;
  esac
  fetch_all || {
    warn "cannot verify max_concurrent_claims against the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"
    return "$EX_FAIL"
  }
  n=$(count_my_live_claims) || {
    warn "cannot determine how many claims this agent already holds, so max_concurrent_claims could not be checked; a tip this client cannot read is a tip it cannot rule out"
    return "$EX_FAIL"
  }
  case ${n:-} in ''|*[!0-9]*) warn "the live-claim count came back as '$n', which is not a whole number"; return "$EX_FAIL" ;; esac
  if [ "$n" -ge "$cap" ]; then
    warn "this agent already holds $n live claims and max_concurrent_claims is $cap"
    return "$EX_FAIL"
  fi

  lease=$(lease_until_now) || return $?
  sha=$(write_claim_commit "$id" "$act" "$lease" "$attempt" "$parent") \
    || { warn "cannot build the claim commit"; return "$EX_FAIL"; }

  push_ref "$sha" "$(claim_ref "$id")"; rc=$?
  case $rc in
    0)
      case $act in
        beat) say "renewed this agent's expired claim on $id until $lease" ;;
        *)    say "claimed $id as $token until $lease (${act})" ;;
      esac
      say "work branch: agent/$id/$token"

      # The participation answer, at claim time, because this is the last
      # moment it can still change what the agent does.
      #
      # It was printed only by `hub done`, which is after the work is finished
      # and after the branch has been pushed. In a shared member repository
      # both of those are the wrong move -- the writes register's work-branch
      # row does not apply there at all, so the push itself is the breach, and
      # the hand-back instruction arrives to tell an agent to stop doing
      # something it has already done. A gate that fires after the gated action
      # is not a gate; it is a report. So the same fact is stated here first,
      # and `hub done` still states it, because an agent that claimed hours ago
      # should not have to remember it.
      #
      # This client checks nothing about the push, and cannot: it makes no API
      # call and never touches a member repository. This is an instruction the
      # agent follows, printed where following it is still cheap.
      #
      # Retires when: the grant stops being scoped by participation, at which
      # point this paragraph, the matching one in cmd_done, and
      # member_solo_for_repo are deleted together.
      # The default is assigned rather than written as ${itemrepo:-...} on
      # purpose. Bash treats a quote character inside the word of a ${x:-word}
      # expansion as a quote even when the whole expansion is already inside
      # double quotes, so an apostrophe there opens a quoted region that runs to
      # the next apostrophe -- across line ends, across the branches of this
      # `if`, and, when the count happens to balance, with no syntax error and
      # no non-zero exit. It merged the two sentences below into one when this
      # paragraph was first written, and the run still exited 0.
      # Retires when: nothing. It is a property of the shell.
      itemrepo=$(item_field "$id" repo)
      [ -n "$itemrepo" ] || itemrepo="the repository named by this item"
      solo=$(member_solo_for_repo "$itemrepo")
      say ""
      if [ "$solo" = "yes" ]; then
        say "Participation: nobody but Brett has worked in $itemrepo, so you may push"
        say "that branch there and, at hand-back, open one draft pull request for it."
      else
        say "Participation: $itemrepo is NOT a repository Brett works alone in."
        say "Do not push that branch and do not open a pull request. Do the work in a"
        say "local worktree, then show Brett the diff and the pull request text in chat"
        say "and wait for him to say yes. A repository whose participation cannot be"
        say "determined is shared, and that is the answer you are reading if $itemrepo"
        say "is not a configured member. The branch name above is the one to use if he"
        say "says yes."
      fi
      return "$EX_OK" ;;
    "$EX_RACE")
      warn "$id was taken by someone else between the read and the push"
      return "$EX_RACE" ;;
    *)
      warn "the claim push failed: $(printf '%s' "$HUB_GIT_OUT" | head -4 | tr '\n' ' ')"
      return "$EX_FAIL" ;;
  esac
}

# ---------------------------------------------------------------------------
# beat
# ---------------------------------------------------------------------------

cmd_beat() {
  local id=$1 token tip rc act ag lease sha attempt hb
  token=$(agent_token) || exit $?
  load_hub_config
  announce_locks_url
  ensure_locks_cache

  tip=$(remote_tip "$id"); rc=$?
  case $rc in
    2) warn "no claim ref for $id, so there is nothing to beat"; return "$EX_FAIL" ;;
    3) warn "cannot read the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac
  fetch_one "$id" || { warn "cannot fetch the claim ref: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL"; }

  act=$(tip_field "$id" action)
  ag=$(tip_field "$id" agent)
  if [ "$ag" != "$token" ]; then
    warn "$id is held by $ag, not by this agent; stop working on it"
    return "$EX_RACE"
  fi
  case $act in
    claim|beat|reclaim) : ;;
    *) warn "the tip of $id is a $act by this agent, so there is no lease to extend"; return "$EX_FAIL" ;;
  esac

  attempt=$(( $(tip_attempt "$id") + 1 ))
  lease=$(lease_until_now) || return $?
  sha=$(write_claim_commit "$id" beat "$lease" "$attempt" "$tip") \
    || { warn "cannot build the heartbeat commit"; return "$EX_FAIL"; }

  push_ref "$sha" "$(claim_ref "$id")"; rc=$?
  case $rc in
    0)
      hb=$(cfg heartbeat_minutes)
      say "beat $id; lease now runs to $lease${hb:+ (next beat due within $hb minutes)}"
      return "$EX_OK" ;;
    "$EX_RACE")
      warn "$id moved since it was read; another agent appended to the ref. Stop working on it"
      return "$EX_RACE" ;;
    *)
      warn "the heartbeat push failed: $(printf '%s' "$HUB_GIT_OUT" | head -4 | tr '\n' ' ')"
      return "$EX_FAIL" ;;
  esac
}

# ---------------------------------------------------------------------------
# release
# ---------------------------------------------------------------------------

cmd_release() {
  local id=$1; shift
  local reason token tip rc act ag sha attempt
  # Everything after the id is the reason, so it needs no quoting at the prompt.
  reason=$*
  [ -n "$reason" ] || reason="released by the agent"
  token=$(agent_token) || exit $?
  load_hub_config
  announce_locks_url
  ensure_locks_cache

  tip=$(remote_tip "$id"); rc=$?
  case $rc in
    2) say "$id has no claim ref, so there was nothing to release"; return "$EX_OK" ;;
    3) warn "cannot read the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac
  fetch_one "$id" || { warn "cannot fetch the claim ref: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL"; }

  act=$(tip_field "$id" action)
  ag=$(tip_field "$id" agent)

  # Releasing what you do not hold is not an error. Saying nothing about it
  # would be, because an agent that thinks it holds an item is wrong.
  if [ "$ag" != "$token" ]; then
    say "$id is held by $ag, not by this agent; nothing released"
    return "$EX_OK"
  fi
  if [ "$act" = "release" ]; then
    say "$id was already released"
    return "$EX_OK"
  fi
  if [ "$act" = "handoff" ]; then
    say "$id was handed off and is waiting for Brett; a handoff is not released by an agent"
    return "$EX_OK"
  fi

  attempt=$(tip_attempt "$id")
  sha=$(write_claim_commit "$id" release "$(tip_field "$id" lease_until)" "$attempt" "$tip" "" "$reason") \
    || { warn "cannot build the release commit"; return "$EX_FAIL"; }

  push_ref "$sha" "$(claim_ref "$id")"; rc=$?
  case $rc in
    0)          say "released $id ($reason)"; return "$EX_OK" ;;
    "$EX_RACE") warn "$id moved since it was read; the release was not recorded"; return "$EX_RACE" ;;
    *)          warn "the release push failed: $(printf '%s' "$HUB_GIT_OUT" | head -4 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac
}

# ---------------------------------------------------------------------------
# done
# ---------------------------------------------------------------------------

cmd_done() {
  local id=$1; shift
  local branch="" token tip rc act ag sha attempt slug forge solo itemrepo
  while [ $# -gt 0 ]; do
    case $1 in
      --branch)   shift; [ $# -gt 0 ] || fail "--branch needs a branch name"; branch=$1 ;;
      --branch=*) branch=${1#--branch=} ;;
      *)          fail "done: unknown argument '$1'" ;;
    esac
    shift
  done
  [ -n "$branch" ] || fail "done needs --branch, naming the branch you pushed"

  token=$(agent_token) || exit $?

  # The grant covers exactly one branch shape, so this client accepts exactly
  # one branch name. It used to accept any string, which meant it would record
  # and print a compare URL for a branch the register does not permit: a client
  # that will hand off a push nobody authorized is a client that breaks the
  # carve-out by accident, and the accident is invisible because the push
  # succeeded.
  #
  # If the name looks right but the token does not, the claim is held by a
  # different session and the holder check below would have said so anyway.
  # Retires when: the authorization paragraph stops naming a branch pattern.
  if [ "$branch" != "agent/$id/$token" ]; then
    fail "done: --branch '$branch' is not a branch this grant covers. The standing authorization in HUB.md permits pushes to 'agent/<queue-id>/<token>' and to nothing else, so for $id held by this session that is exactly 'agent/$id/$token'"
  fi

  load_hub_config
  announce_locks_url
  ensure_locks_cache

  tip=$(remote_tip "$id"); rc=$?
  case $rc in
    2) warn "no claim ref for $id, so there is no claim to hand off"; return "$EX_FAIL" ;;
    3) warn "cannot read the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac
  fetch_one "$id" || { warn "cannot fetch the claim ref: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL"; }

  act=$(tip_field "$id" action)
  ag=$(tip_field "$id" agent)
  if [ "$ag" != "$token" ]; then
    warn "$id is held by $ag, not by this agent"
    return "$EX_RACE"
  fi
  if [ "$act" = "handoff" ]; then
    say "$id was already handed off on branch $(tip_field "$id" branch)"
    return "$EX_OK"
  fi

  attempt=$(tip_attempt "$id")
  # A handoff keeps the claim. The item stays unclaimable until Brett merges,
  # so finished work never looks free again while he is away.
  sha=$(write_claim_commit "$id" handoff "$(tip_field "$id" lease_until)" "$attempt" "$tip" "$branch") \
    || { warn "cannot build the handoff commit"; return "$EX_FAIL"; }

  push_ref "$sha" "$(claim_ref "$id")"; rc=$?
  case $rc in
    0) : ;;
    "$EX_RACE") warn "$id moved since it was read; the handoff was not recorded"; return "$EX_RACE" ;;
    *) warn "the handoff push failed: $(printf '%s' "$HUB_GIT_OUT" | head -4 | tr '\n' ' ')"; return "$EX_FAIL" ;;
  esac

  say "handed off $id on branch $branch; the claim stays held until Brett merges"
  itemrepo=$(item_field "$id" repo)
  slug=$(member_slug_for_repo "$itemrepo")
  forge=$(member_forge_for_repo "$itemrepo")
  solo=$(member_solo_for_repo "$itemrepo")

  # Two independent facts, printed as two paragraphs, because they answer two
  # different questions and used to be answered by one test.
  #
  # The forge decides whether a compare URL can be built, and nothing else.
  say ""
  if [ -z "$slug" ]; then
    warn "item repo '$itemrepo' is not in the configured members list, so no compare URL was printed"
  elif [ "$forge" = "github" ]; then
    say "The compare page for this branch is:"
    say "  https://github.com/$slug/compare/$branch?expand=1"
  else
    say "No compare page for this branch: $itemrepo is a $forge member and this"
    say "client knows only GitHub's compare-page URL shape."
  fi

  # Participation decides what the agent may do with it. The grant in HUB.md is
  # scoped by who else has worked in the repository, so that is what this
  # branches on.
  #
  # It branched on the forge until 2026-09-10, which printed the draft
  # pull-request instruction for every GitHub member. Two GitHub members are
  # shared, so on a hand-back there the client told an agent to do the one
  # thing the grant forbids, and an agent that follows its own tooling would
  # have done it. Tooling that instructs a breach is worse than tooling that
  # allows one: the breach reads as compliance in the transcript.
  #
  # Retires when: the grant stops being scoped by participation, at which point
  # member_solo_for_repo goes with it.
  say ""
  if [ "$solo" = "yes" ]; then
    say "Open one draft pull request for this branch, labelled agent-run and naming"
    say "$id in the body. Draft only: never marked ready for review, never merged,"
    say "and never a second one for this item."
  else
    say "STOP here. Do not open a pull request, because $itemrepo is not a repository"
    say "Brett works alone in and the grant reaches no other kind. Draft the pull"
    say "request body in chat and wait for Brett."
  fi
  return "$EX_OK"
}

# ---------------------------------------------------------------------------
# reconcile
# ---------------------------------------------------------------------------

cmd_reconcile() {
  local ref id act ag lu now grace sha rc problems=0 expired=0 skipped=0
  load_hub_config
  announce_locks_url
  ensure_locks_cache
  fetch_all || { warn "cannot read the locks repository: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"; return "$EX_FAIL"; }
  grace=$(cfg_required reclaim_grace_minutes) || return $?
  now=$(now_epoch)

  for ref in $(lg for-each-ref --format='%(refname)' refs/hub/claim/ 2>/dev/null); do
    id=${ref##*/}
    act=$(tip_field "$id" action)
    ag=$(tip_field "$id" agent)
    case $act in
      handoff)
        # Never touched. Finished work waits for Brett, and a reconcile that
        # freed it would put an agent back onto work that is already done.
        say "skip    $id: handed off by $ag, waiting for Brett"
        skipped=$((skipped + 1)); continue ;;
      release)
        skipped=$((skipped + 1)); continue ;;
      claim|beat|reclaim) : ;;
      *)
        say "problem $id: tip action is '${act:-absent}', which this client did not write"
        problems=$((problems + 1)); continue ;;
    esac

    if ! lu=$(epoch_from_iso "$(tip_field "$id" lease_until)" 2>/dev/null); then
      say "problem $id: lease_until '$(tip_field "$id" lease_until)' cannot be parsed; left alone"
      problems=$((problems + 1)); continue
    fi
    if [ "$now" -lt $(( lu + grace * 60 )) ]; then
      continue
    fi

    sha=$(write_claim_commit "$id" release "$(tip_field "$id" lease_until)" \
          "$(tip_attempt "$id")" "$(lg rev-parse "$ref")" "" \
          "lease expired at $(tip_field "$id" lease_until), reconciled after the $grace minute grace") \
      || { say "problem $id: cannot build the expiry commit"; problems=$((problems + 1)); continue; }

    push_ref "$sha" "$(claim_ref "$id")"; rc=$?
    case $rc in
      0) say "expired $id: lease from $ag ran out at $(tip_field "$id" lease_until); the item is claimable again"
         expired=$((expired + 1)) ;;
      "$EX_RACE")
         # Benign: the holder beat, released, or another reconcile got there
         # first. Reconcile is not competing for the item.
         say "moved   $id: the ref changed while reconciling; left as it now stands" ;;
      *) say "problem $id: the expiry push failed: $(printf '%s' "$HUB_GIT_OUT" | head -2 | tr '\n' ' ')"
         problems=$((problems + 1)) ;;
    esac
  done

  say ""
  say "reconciled: expired $expired, left alone $skipped, problems $problems"
  say "Note that this never edits a queue item file. Item state is set by a"
  say "commit on main; expiring the lock is what"
  say "makes a ready item claimable again."
  [ "$problems" -eq 0 ] || return "$EX_FAIL"
  return "$EX_OK"
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------

cmd_help() {
  cat >&2 <<'USAGE'
hub - the queue client for the salmon ecosystem hub

  hub doctor                     check this machine, the configuration, and
                                 whether the claim prefix accepts a push
  hub ready                      list claimable items. A claim ref is never
                                 deleted, so this reads each ref's tip rather
                                 than its existence: a released ref, and one
                                 whose lease and reclaim grace have both
                                 elapsed while its reclaim cap is not spent,
                                 are free and are listed
  hub ready --set ID [--authorization TEXT]
                                 print the one-line edit that moves ID to
                                 ready, and what the promotion commit must cite.
                                 An agent may make that commit on an
                                 authorization Brett gave in chat; this client
                                 does not, because it commits in no repository
  hub claim ID                   take the item, by pushing to its claim ref.
                                 Claiming what you already hold on a live lease
                                 succeeds and changes nothing; claiming what you
                                 hold on an expired one renews the lease against
                                 the ref, and exits 4 if somebody reclaimed it
                                 first
  hub beat ID                    extend the lease you hold
  hub release ID [reason]        give the item back
  hub done ID --branch B         hand off: record the branch, keep the claim,
                                 print the compare URL, and say what to do with
                                 it. In a repository nobody but Brett has
                                 contributed to that is one draft pull request;
                                 in one he shares it is stop, draft the body in
                                 chat, and wait. B must be exactly
                                 agent/ID/<your token>, because that is the only
                                 branch the standing authorization covers;
                                 anything else exits 3
  hub reconcile                  expire dead leases back to claimable
  hub help                       this

Options and environment:
  --batch, HUB_MODE=batch        use lease_hours_batch instead of the
                                 interactive lease
  HUB_AGENT_TOKEN                override the per-session agent token; it must
                                 be opaque, because the lock history is public
                                 to everyone who can read the locks repository
  HUB_SESSION_KEY                name this agent session explicitly. Set it when
                                 more than one agent runs on one machine and no
                                 harness session id is in the environment
  HUB_LOCKS_URL                  point at a throwaway locks repository, for the
                                 two-terminal race test. Honoured ONLY while
                                 locks_repo is still the placeholder: once the
                                 real repository is configured, setting this is
                                 an error rather than a redirect
  HUB_CACHE_DIR                  where the local locks object cache lives

Every command that pushes prints the effective locks repository URL and where
that URL came from, before it pushes. A push sent to the wrong remote is the
one failure here that produces no error at all, so that line is the evidence.

Exit codes:
  0  success
  4  lost the race, or the item is held by someone else
  3  anything else, including no network, no credential, a missing repository,
     an ineligible item, or a precondition that could not be verified

  4 and 3 are different on purpose. An agent that reads an expired credential
  as "someone else got there first" walks the whole queue reporting nothing
  wrong, which is the failure this distinction exists to prevent.

State lives in queue/. Policy lives in HUB.md. This client makes no
GitHub API call, opens no pull request, posts no comment, and commits or pushes
nowhere but the locks repository. That is a description of the client and not a
rule about you: what an agent may do is in HUB.md's writes register, and it is
wider than this list.
USAGE
  return "$EX_OK"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  local cmd a n i
  [ $# -gt 0 ] || { cmd_help; return "$EX_FAIL"; }

  # A global --batch may appear anywhere, so strip it before the subcommand
  # sees the arguments. Rotating the positional parameters rather than building
  # a string keeps an argument with spaces, such as a release reason, intact.
  n=$#
  i=0
  while [ "$i" -lt "$n" ]; do
    a=$1; shift
    if [ "$a" = "--batch" ]; then
      HUB_BATCH=1
    else
      set -- "$@" "$a"
    fi
    i=$((i + 1))
  done
  : "${HUB_BATCH:=0}"
  export HUB_BATCH

  [ $# -gt 0 ] || { cmd_help; return "$EX_FAIL"; }
  cmd=$1; shift

  case $cmd in
    doctor)    cmd_doctor "$@" ;;
    ready)     cmd_ready "$@" ;;
    claim)     [ $# -ge 1 ] || fail "claim needs an item id"; cmd_claim "$1" ;;
    beat)      [ $# -ge 1 ] || fail "beat needs an item id"; cmd_beat "$1" ;;
    release)   [ $# -ge 1 ] || fail "release needs an item id"; cmd_release "$@" ;;
    done)      [ $# -ge 1 ] || fail "done needs an item id"; cmd_done "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    help|-h|--help) cmd_help ;;
    *)         warn "unknown subcommand '$cmd'"; cmd_help; return "$EX_FAIL" ;;
  esac
}

# Sourcing this file with HUB_LIB=1 loads the helpers without running a
# subcommand, which is how the pure functions are exercised in a test without
# touching a git object store or a remote.
if [ "${HUB_LIB:-0}" != "1" ]; then
  main "$@"
fi
